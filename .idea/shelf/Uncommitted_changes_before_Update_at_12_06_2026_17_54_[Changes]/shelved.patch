<+>\r\nlet taskFilter = 'all';\r\nlet movieFilter = 'all';\r\nlet authInProgress = false;\r\n\r\n    const SUPABASE_URL = \"https://vexrmjmpencefrqjskqq.supabase.co\";\r\n    const SUPABASE_KEY = \"sb_publishable_DeXs1AZIIJF-NjkF4xB8Vg_2nslRCuG\";\r\n\r\n    const supabaseClient = supabase.createClient(\r\n      SUPABASE_URL,\r\n      SUPABASE_KEY\r\n    );\r\n\r\nlet tasksLoaded = false;\r\n\r\nconst tabs = document.querySelector('.nav-tabs');\r\nconst wrapper = document.querySelector('.nav-tabs-wrapper');\r\n\r\ntabs.addEventListener('scroll', () => {\r\n  if (tabs.scrollLeft > 5) {\r\n    wrapper.classList.add('scrolled');\r\n  } else {\r\n    wrapper.classList.remove('scrolled');\r\n  }\r\n});\r\n\r\n\r\n\r\n// ====================================================\r\n// DATA —\r\n// ====================================================\r\n\r\n// ====================================================\r\n// DATA —  movies here!\r\n// ====================================================\r\n\r\n\r\nlet movies = [];\r\n\r\nasync function loadMovies() {\r\n  const { data, error } = await supabaseClient\r\n    .from('movies')\r\n    .select('*')\r\n    .order('created_at', { ascending: false });\r\n\r\n  if (error) return console.error(error);\r\n\r\n  movies = data;\r\n  renderMovies();\r\n}\r\n\r\n\r\nlet moviesLoaded = false;\r\n\r\nasync function ensureMoviesLoaded() {\r\n  if (moviesLoaded) return;\r\n  await loadMovies();\r\n  moviesLoaded = true;\r\n}\r\n\r\nfunction renderMovies() {\r\n  const tabMovies = document.getElementById('tab-movies');\r\n  const container = document.getElementById('timeline-movies');\r\n  container.innerHTML = '';\r\n\r\n  let filteredMovies = movies;\r\n\r\n  if (movieFilter === 'pending') {\r\n    filteredMovies = movies.filter(m => !m.watched);\r\n  }\r\n  if (movieFilter === 'done') {\r\n    filteredMovies = movies.filter(m => m.watched);\r\n  }\r\n\r\n  filteredMovies.forEach(movie => {\r\n    const row = document.createElement('div');\r\n    row.className = 'post-row visible movie-row';\r\n\r\n    row.innerHTML = `\r\n      <div class=\"post-card\">\r\n        <div class=\"card-body\">\r\n\r\n          <div style=\"display:flex;justify-content:space-between;align-items:center;gap:10px;\">\r\n\r\n            <div style=\"display:flex;gap:10px;align-items:center;\">\r\n              <input type=\"checkbox\" ${movie.watched ? \"checked\" : \"\"}\r\n                onchange=\"toggleMovie(${movie.id}, this.checked)\" />\r\n\r\n              <div class=\"card-title\"\r\n                style=\"${movie.watched ? 'text-decoration:line-through;opacity:0.5' : ''}\">\r\n                \uD83C\uDFAC ${movie.title}\r\n              </div>\r\n            </div>\r\n\r\n            <div style=\"display:flex;gap:8px;\">\r\n              <button onclick=\"editMovie(${movie.id})\">✏\uFE0F</button>\r\n              <button onclick=\"deleteMovie(${movie.id})\">\uD83D\uDDD1\uFE0F</button>\r\n            </div>\r\n\r\n          </div>\r\n\r\n        </div>\r\n      </div>\r\n    `;\r\n\r\n    container.appendChild(row);\r\n  });\r\n}\r\n\r\nasync function addMovie() {\r\n  const input = document.getElementById('newMovieInput');\r\n  const value = input.value.trim();\r\n\r\n  if (!value) return;\r\n\r\n  const { data, error } = await supabaseClient\r\n    .from('movies')\r\n    .insert([{ title: value }])\r\n    .select();\r\n\r\n  if (error) return console.error(error);\r\n\r\n  movies.unshift(data[0]);\r\n  input.value = '';\r\n  renderMovies();\r\n}\r\n\r\nasync function toggleMovie(id, watched) {\r\n  const { error } = await supabaseClient\r\n    .from('movies')\r\n    .update({ watched })\r\n    .eq('id', id);\r\n\r\n  if (error) return console.error(error);\r\n\r\n  const m = movies.find(x => x.id === id);\r\n  if (m) m.watched = watched;\r\n\r\n  renderMovies();\r\n}\r\n\r\n\r\nasync function deleteMovie(id) {\r\n  await supabaseClient.from('movies').delete().eq('id', id);\r\n  movies = movies.filter(m => m.id !== id);\r\n  renderMovies();\r\n}\r\n\r\nasync function editMovie(id) {\r\n  const movie = movies.find(m => m.id === id);\r\n  const newTitle = prompt(\"Edit movie:\", movie.title);\r\n  if (!newTitle) return;\r\n\r\n  await supabaseClient\r\n    .from('movies')\r\n    .update({ title: newTitle })\r\n    .eq('id', id);\r\n\r\n  movie.title = newTitle;\r\n  renderMovies();\r\n}\r\n\r\n\r\n// ====================================================\r\n// DATA —  tasks here!\r\n// ====================================================\r\n\r\n\r\n\r\nlet tasks = [];\r\n\r\nasync function loadTasks() {\r\n  const { data, error } = await supabaseClient\r\n    .from('tasks')\r\n    .select('*')\r\n    .order('created_at', { ascending: false });\r\n\r\n  if (error) {\r\n    console.error(error);\r\n    return;\r\n  }\r\n\r\n  tasks = data;\r\n  renderTasks();\r\n}\r\n\r\nfunction renderTasks() {\r\n  const container = document.getElementById('timeline-tasks');\r\n  container.innerHTML = '';\r\n\r\nlet pending = tasks.filter(t => !t.completed);\r\nlet done = tasks.filter(t => t.completed);\r\n\r\nif (taskFilter === 'pending') {\r\n  done = [];\r\n}\r\nif (taskFilter === 'done') {\r\n  pending = [];\r\n}\r\n\r\n  // helper: reuse your exact existing row HTML\r\n  const makeRow = (task) => {\r\n    const row = document.createElement('div');\r\n    row.className = 'post-row visible task-row';\r\n\r\n    row.innerHTML = `\r\n      <div class=\"post-card\">\r\n        <div class=\"card-body\">\r\n\r\n          <div style=\"display:flex;align-items:center;justify-content:space-between;gap:10px;\">\r\n\r\n            <div style=\"display:flex;align-items:center;gap:10px;\">\r\n              <input type=\"checkbox\" ${task.completed ? \"checked\" : \"\"}\r\n                onchange=\"toggleTask(${task.id}, this.checked)\" />\r\n\r\n              <div class=\"card-title\" style=\"${task.completed ? 'text-decoration:line-through;opacity:0.5' : ''}\">\r\n                ${task.task}\r\n              </div>\r\n            </div>\r\n\r\n            <div style=\"display:flex;gap:8px;\">\r\n              <button onclick=\"editTask(${task.id})\">✏\uFE0F</button>\r\n              <button onclick=\"deleteTask(${task.id})\">\uD83D\uDDD1\uFE0F</button>\r\n            </div>\r\n\r\n          </div>\r\n\r\n        </div>\r\n      </div>\r\n    `;\r\n\r\n    return row;\r\n  };\r\n\r\n  // SECTION 1: Pending\r\n  const pendingTitle = document.createElement('div');\r\n  pendingTitle.style = \"max-width:1000px;margin:0 auto 10px;font-weight:700;color:#94a3b8;\";\r\n  pendingTitle.textContent = \"⏳ Pending\";\r\n\r\n  container.appendChild(pendingTitle);\r\n  pending.forEach(t => container.appendChild(makeRow(t)));\r\n\r\n  // spacing\r\n  const spacer = document.createElement('div');\r\n  spacer.style.height = \"30px\";\r\n  container.appendChild(spacer);\r\n\r\n  // SECTION 2: Done\r\n  const doneTitle = document.createElement('div');\r\n  doneTitle.style = \"max-width:1000px;margin:0 auto 10px;font-weight:700;color:#94a3b8;\";\r\n  doneTitle.textContent = \"✅ Completed\";\r\n\r\n  container.appendChild(doneTitle);\r\n  done.forEach(t => container.appendChild(makeRow(t)));\r\n}\r\n\r\nasync function addTask() {\r\n  const input = document.getElementById('newTaskInput');\r\n  const value = input.value.trim();\r\n\r\n  if (!value) return;\r\n\r\n  const { data, error } = await supabaseClient\r\n    .from('tasks')\r\n    .insert([{ task: value }])\r\n    .select();\r\n\r\n  if (error) {\r\n    console.error(error);\r\n    return;\r\n  }\r\n\r\n  tasks.unshift(data[0]);\r\n  input.value = '';\r\n  renderTasks();\r\n}\r\n\r\nasync function toggleTask(id, completed) {\r\n  const { error } = await supabaseClient\r\n    .from('tasks')\r\n    .update({ completed })\r\n    .eq('id', id);\r\n\r\n  if (error) {\r\n    console.error(error);\r\n    return;\r\n  }\r\n\r\n  const t = tasks.find(x => x.id === id);\r\n  if (t) t.completed = completed;\r\n\r\n  renderTasks();\r\n}\r\n\r\n\r\n\r\nasync function deleteTask(id) {\r\n  const { error } = await supabaseClient\r\n    .from('tasks')\r\n    .delete()\r\n    .eq('id', id);\r\n\r\n  if (error) {\r\n    console.error(error);\r\n    return;\r\n  }\r\n\r\n  tasks = tasks.filter(t => t.id !== id);\r\n  renderTasks();\r\n}\r\n\r\n\r\nasync function editTask(id) {\r\n  const task = tasks.find(t => t.id === id);\r\n  const newText = prompt(\"Edit task:\", task.task);\r\n\r\n  if (!newText) return;\r\n\r\n  const { error } = await supabaseClient\r\n    .from('tasks')\r\n    .update({ task: newText })\r\n    .eq('id', id);\r\n\r\n  if (error) {\r\n    console.error(error);\r\n    return;\r\n  }\r\n\r\n  task.task = newText;\r\n  renderTasks();\r\n}\r\n\r\n\r\n\r\nasync function ensureTasksLoaded() {\r\n  if (tasksLoaded) return;\r\n  await loadTasks();\r\n  tasksLoaded = true;\r\n}\r\n\r\n// ====================================================\r\n// DATA —  posts here!\r\n// ====================================================\r\n\r\n\r\n\r\nconst POSTS = {\r\n  main: [\r\n    {\r\n      title: \"\",\r\n      date: \"2025-09-15\",\r\n      photos: [\r\n        \"https://scontent.ftlv20-3.fna.fbcdn.net/v/t39.30808-6/548124882_1301688905082331_1071513579234263600_n.jpg?stp=cp6_dst-jpg_tt6&_nc_cat=109&ccb=1-7&_nc_sid=833d8c&_nc_ohc=eWhPagOBMfcQ7kNvwGByZAR&_nc_oc=AdoQv3SVLzpEOYD61i9ScPtByqZWhPdBEB9W4JNFk0SohxbNbYX2k4BQOWnL_lZ3LFP1kDlB9cEqkqc4M23r91EV&_nc_zt=23&_nc_ht=scontent.ftlv20-3.fna&_nc_gid=uBJjUDsWThHHfGLaoWJE7Q&_nc_ss=7b2a8&oh=00_Af7ZNHcW4tJb2s36Okmv-V0oZZa84A2jkmY97yrBVwH-Kg&oe=6A155798\",\r\n        \"https://scontent.ftlv20-1.fna.fbcdn.net/v/t39.30808-6/548514776_1301688948415660_8927827410116630479_n.jpg?_nc_cat=110&ccb=1-7&_nc_sid=833d8c&_nc_ohc=cq17f4FWKFMQ7kNvwEpt-pl&_nc_oc=AdpVrBkWxjaWa_15dqrXwWOqp0AD49apfCQuEGSsWcYWnWW0MIrQmTNbohI_pB3fShxoHmclAhlAzJGIq6ilMUTP&_nc_zt=23&_nc_ht=scontent.ftlv20-1.fna&_nc_gid=GhwOKYX96Yw3S5l8NZzKvQ&_nc_ss=7b2a8&oh=00_Af7h3kNuS89lcKzTB6e0-0ZgIQad_p9EtVxidD1sWGoB-g&oe=6A15513A\",\r\n        \"https://scontent.ftlv20-2.fna.fbcdn.net/v/t39.30808-6/547005160_1301688975082324_5574386510447917089_n.jpg?stp=cp6_dst-jpg_tt6&_nc_cat=100&ccb=1-7&_nc_sid=833d8c&_nc_ohc=oP460wG4Qy0Q7kNvwGcNb2_&_nc_oc=AdpC08Bqoe10lhjlGCfLcF65CBjLu9-DkwsEVPUoMmzyVjou2DLhJI4IjKjsiy5SD_0I88a9hnkMM9rM0YyfwnJJ&_nc_zt=23&_nc_ht=scontent.ftlv20-2.fna&_nc_gid=wKGZISuRRf-swmJuibU0MA&_nc_ss=7b2a8&oh=00_Af7zn0qPodr6Ilwx-4NMu0ZwmuFbrdBuap-0Ru6YrcptSQ&oe=6A1537E4\"\r\n      ],\r\n      content: `Forgotten Roots and the Misconceptions Spread\r\n1) Forgotten Roots, Who are the Palestinians?\r\nMany Palestinians today identify as Arabs because we speak Arabic and have lived under Arab Islamic culture for over 1,400 years. But history and genetics tell a deeper story: we are descendants of the original Canaanites, the people who lived here thousands of years before the Arab migrations.\r\n• The Canaanite languages (including early Hebrew and Phoenician) were spoken here long before Arabic.\r\n• The original religion was polytheistic, worshipping deities like El, Baal, and Asherah.\r\n• My own DNA results confirm direct continuity with ancient Canaanite populations evidence that modern Palestinians are not outsiders but the living descendants of the very first people of this land.\r\nAdopting Arabic and Islam later in history did not erase these roots. We did not come from the Arabian Peninsula we were always here.\r\n2) The History of Canaan\r\nCanaan was never a single empire it was a mosaic of city-states and later a prize for great powers: Egyptian, Assyrian, Babylonian, Persian, Greek, and Roman.\r\nBut through it all, the Canaanites remained the foundation of the population.\r\n• Phoenicians flourished along the coast.\r\n• Highland Canaanites evolved into the Israelite kingdoms.\r\n• The Philistines whose very name comes from the Hebrew Pelištīm, meaning “invaders” or “migrants” arrived from the Aegean around the 12th century BCE and settled along the southern coast. Over time, they blended with locals but were never the indigenous people of Canaan.\r\nEmpires came and went, but the people of the land adapted and endured.\r\n3) The Rise of Judaism & the Israelites\r\nThe Israelites emerged from within Canaanite society itself. They were not foreign invaders but Canaanites who developed a new religious identity.\r\n• The high god El of Canaan became Elohim in Hebrew.\r\n• Early Israelites also worshipped alongside Asherah and Baal before gradually shifting to Yahweh.\r\n• Over time, especially after the Babylonian exile, Israelite faith moved from polytheism to strict monotheism, giving birth to Judaism.\r\nThis was not a replacement of Canaanites it was a transformation among them.\r\n4) How the Land Became “Palestine”\r\nAfter the Bar Kokhba revolt (132–136 CE), the Romans renamed the province Syria Palaestina.\r\n• This was partly to punish the Jews by erasing Judaea’s name and mocking them with the name of their ancient rivals the Philistines, remembered as outsiders in biblical tradition.\r\n• Later, under Byzantine and Islamic rule, the name persisted.\r\nSo the word “Palestine” has foreign origins, but the people remained the same Canaanite descendants beneath every name and empire.\r\n5) Continuity Through Languages & Religions\r\nOne of the greatest misconceptions today is that adopting a new language or faith makes you a “different” people. That is not true.\r\n• Canaanites first spoke Canaanite dialects, then Aramaic, and later Arabic.\r\n• They first worshipped a pantheon of gods, then some became Jews, others Christians, and later many became Muslims.\r\nBut none of these shifts erased their history or bloodlines. Just as speaking Hebrew today does not automatically make someone an ancient Israelite, speaking Arabic does not mean Palestinians came from Arabia. Language and religion can change, ancestry does not.\r\n6) Conclusion:  Lost Memory, Living People\r\nModern debates about this land often ignore both history and genetics. Some say Palestinians are just “Arabs,” others claim Jews alone have the ancestral link. Both are incomplete.\r\nThe truth is layered:\r\n• Palestinians are the living descendants of the Canaanites.\r\n• Judaism was born within the Canaanite world.\r\n• The name “Palestine” came from Romans and Greeks, not from Canaan itself.\r\n• Over millennia, the people adapted to new rulers, new languages, and new faiths yet their roots remained.\r\nEmpires fall, names change, religions shift but the people of this land carried their ancestry through every era. To forget that is to lose sight of the truth.\r\nWe are the Canaanites. We always were.`\r\n    },\r\n\r\n    {\r\n      title: \"\",\r\n      date: \"2026-05-27\",\r\n      photos: [\r\n        \"https://cdn.jsdelivr.net/gh/bw3123/our-treasure@main/pics/skin1.jpeg\",\r\n        \"https://cdn.jsdelivr.net/gh/bw3123/our-treasure@main/pics/skin2.jpeg\",\r\n        \"https://cdn.jsdelivr.net/gh/bw3123/our-treasure@main/pics/skin3.jpeg\",\r\n        \"https://cdn.jsdelivr.net/gh/bw3123/our-treasure@main/pics/skin4.jpeg\",\r\n         ],\r\n      content: `● Have you ever wondered why humans evolved different skin tones?\r\nThe answer begins with: Melanin.\r\nMost people think melanin only affects appearance. In reality, it is one of the most important evolutionary adaptations humans ever developed.\r\nMelanin is the pigment responsible for skin, hair, and eye color. But biologically, its main role is protection.\r\n● The Sun emits ultraviolet (UV) radiation. Too much UV exposure damages DNA, accelerates aging, increases skin cancer risk, and can even destroy folate (Vitamin B9), which is essential for fertility and fetal development.\r\n● Early humans evolved in regions with intense sunlight, especially near the equator. Because of this, evolution favored darker skin with higher melanin levels.\r\nWhy? Because melanin acts like a natural UV shield.\r\nIt absorbs and scatters part of the ultraviolet radiation before it penetrates deeper into the skin.\r\nIn simple terms: More melanin = more natural protection against intense sunlight.\r\n● As humans moved into colder regions with weaker sunlight, a new biological problem appeared:\r\nVitamin D deficiency.\r\nThe human body produces Vitamin D3 using sunlight.\r\nWhen UVB rays hit the skin, they trigger a chemical reaction:\r\n▪\uFE0E 7-dehydrocholesterol + UVB radiation → previtamin D3 → vitamin D3 (cholecalciferol)\r\nThe problem is: Melanin also reduces the amount of UVB that reaches the deeper skin layers where this process happens.\r\nSo while darker skin protects better against UV damage, it also slows Vitamin D3 production in low-sunlight environments.\r\nBecause of this, evolution gradually favored lighter skin in northern regions since it allowed more efficient Vitamin D synthesis under weak sunlight.\r\n● Why is Vitamin D3 so important? Vitamin D3 is not “just a vitamin.” It functions more like a hormone and affects multiple systems in the body.\r\nIt plays major roles in:\r\n• Calcium absorption and bone strength.\r\n• Immune system regulation\r\n• Muscle function\r\n• Hormone balance\r\n• Brain and mood regulation\r\nLow Vitamin D levels are associated with:\r\n• Fatigue\r\n• Weak bones\r\n• Immune dysfunction\r\n• Depression and seasonal mood changes\r\n● This is one reason why populations with darker skin living in very low UV environments may have higher risks of Vitamin D deficiency if diet and lifestyle do not compensate properly.\r\nMeanwhile, populations with lighter skin exposed to intense sunlight have less natural UV protection, increasing the risk of skin damage and skin cancer.\r\nSo neither skin tone is “better.”\r\nEach evolved as a biological adaptation to different environmental pressures.\r\nHuman skin color is basically evolution negotiating with the Sun.\r\nYour skin is not random. It is a map of where your ancestors survived for thousands of years.`\r\n    },\r\n\r\n\r\n  {\r\n      title: \"\",\r\n      date: \"2026-05-21\",\r\n      photos: [\r\n        \"https://scontent.ftlv20-1.fna.fbcdn.net/v/t39.30808-6/702734400_1523111532940066_7487092687627016305_n.jpg?stp=cp6_dst-jpg_tt6&_nc_cat=111&ccb=1-7&_nc_sid=833d8c&_nc_ohc=AldOS4tK598Q7kNvwHHKJ0D&_nc_oc=Adr7tX7mNHGx1M-NHWGvNYMM0r2a5eEdAfit7Ipq75CHnlDplEma7_2uP1BLehSsza6YHWAbKrsVcyXOD26AlZWA&_nc_zt=23&_nc_ht=scontent.ftlv20-1.fna&_nc_gid=iOHXUBiQ4ylL5I8cbD8-pA&_nc_ss=7b2a8&oh=00_Af6TGGBJ10ORmaN_qfO8a6yD2biIgZaB3HHo0uVml7z0UA&oe=6A154ACD\",\r\n\t\t\"https://scontent.ftlv20-2.fna.fbcdn.net/v/t39.30808-6/703890868_1523111572940062_8065805004993632444_n.jpg?stp=cp6_dst-jpg_tt6&_nc_cat=102&ccb=1-7&_nc_sid=833d8c&_nc_ohc=iI9YGqeRKWMQ7kNvwErOO-k&_nc_oc=AdoxB_pGZsp_xvN_gLXnMmqwnyLTp4clp83ZXbH8GIalDtGxV4nt7mUJfDgptCwX0s0L-sJmEPW6TPPpjzs0NCCb&_nc_zt=23&_nc_ht=scontent.ftlv20-2.fna&_nc_gid=QuSseE9KvjHGPc9TCtclyw&_nc_ss=7b2a8&oh=00_Af4ut_gz3Zc0VzwcHA1FMSKxzpy8MzOuLlPOON8JOVdnrQ&oe=6A1559A4\",\r\n\t\t\"https://scontent.ftlv20-2.fna.fbcdn.net/v/t39.30808-6/702502103_1523111616273391_4386684403104055755_n.jpg?stp=cp6_dst-jpg_tt6&_nc_cat=101&ccb=1-7&_nc_sid=833d8c&_nc_ohc=Q8MkKLhW550Q7kNvwH3x1RN&_nc_oc=AdqyA647S1lXkN5432q4Z9S1x4OnOz7VNEiIifd060uWQ4cHZPzxVeyrAxEpXzzVJ8bZvX4VHW0eVOvD54PRuDOZ&_nc_zt=23&_nc_ht=scontent.ftlv20-2.fna&_nc_gid=tGwbuR5ZJZ_eOqYdCJDwtw&_nc_ss=7b2a8&oh=00_Af6fT95ghD4vSjOQnV6yG8HnfYVVnlVT2ZYdifppxtCeMA&oe=6A155EFE\"\r\n      ],\r\n      content: `Humanity learned how bacteria defend themselves and turned it into a gene-editing weapon. The power to rewrite life no longer belongs to evolution alone.\r\n● CRISPR-Cas9: The Biological Cheat Code\r\nMost people think bacteria are primitive little blobs floating around doing nothing.\r\nWrong.\r\nBacteria have been fighting biological warfare for billions of years. And in that war, they accidentally invented one of the most powerful technologies humanity has ever touched:\r\nCRISPR-Cas9\r\nA system so precise it can literally edit DNA almost like using “find and replace” in a Word document.\r\nYeah. Nature casually invented molecular programming before humans even discovered electricity.\r\n● First: Why Did Bacteria Create CRISPR?\r\nBacteria constantly get attacked by viruses called: Bacteriophage\r\nThese viruses inject genetic material into bacteria and hijack them to make more viruses until the cell explodes.\r\nSo bacteria evolved a defense mechanism.\r\nInstead of just dying helplessly, they started keeping genetic “mugshots” of viruses that attacked them before.\r\nThat memory system became:\r\nCRISPR\r\nClustered Regularly Interspaced Short Palindromic Repeats\r\nWhich honestly sounds less like biology and more like Elon Musk naming his child.\r\n● How Does CRISPR Actually Work?\r\nImagine this:\r\nA virus attacks a bacterium.\r\nThe bacterium survives.\r\nIt cuts a small piece of the viral DNA and stores it inside its own genome like a biological FBI database.\r\nNext time the virus attacks:\r\n1) The bacterium recognizes the viral DNA\r\n2) It produces a guide RNA matching the virus\r\n3) The enzyme Cas9 follows that guide\r\n4) Cas9 cuts the viral DNA apart\r\nDone. Threat neutralized.\r\nIt’s literally molecular scissors guided by genetic GPS.\r\n● The Cas9 Enzyme\r\nCas9 = the executioner\r\nScientists realized something terrifyingly genius:\r\n“What if we could program Cas9 to cut ANY DNA sequence we want?”\r\nAnd suddenly biology changed forever.\r\nInstead of targeting viruses:\r\nWe can target:\r\n• defective genes\r\n• mutations\r\n• cancer related sequences\r\n• viral DNA\r\n• inherited diseases\r\n• Potentially even traits.\r\nThat’s where things get ethically spicy.\r\n● What Can CRISPR Potentially Do?\r\n1) Genetic Diseases:\r\nScientists are already using CRISPR experimentally against:\r\n•sickle cell anemia\r\n•certain inherited blindness conditions\r\n•muscular disorders\r\n2) Cancer Research\r\nModified immune cells can potentially be engineered to attack tumors more effectively.\r\n3) Agriculture\r\nCRISPR can create crops that:\r\n•resist drought\r\n•survive disease\r\n•need fewer pesticides\r\nViral Research\r\nSome scientists are exploring whether CRISPR systems could target viral genomes directly.\r\n● But Here’s The Dark Part\r\nCRISPR is powerful. Too powerful.\r\nBecause once you can edit genes, you can start asking dangerous questions.\r\nWhere is the line?\r\nTreat disease?\r\nEnhance intelligence?\r\nDesigner babies?\r\nPhysical traits?\r\nSelective genetics?\r\n• Now we enter philosophical territory.\r\nBecause humanity historically sucks at handling power responsibly.\r\n• The Biggest Fear: Germline Editing\r\nIf edits are made in embryos:\r\nThe changes can pass to future generations.\r\nMeaning: You are not just editing one human.\r\nYou are editing an entire bloodline.\r\nThat’s insane when you really think about it.\r\nOne lab mistake could echo through generations like a biological typo nobody can fully erase.\r\n● CRISPR-Cas9 might become:\r\none of humanity’s greatest medical breakthroughs or one of the biggest ethical disasters in scientific history\r\nProbably both.\r\nBecause every powerful technology in history has been both salvation and catastrophe depending on who holds it.\r\nFire. Nuclear energy. Artificial intelligence. Genetic editing joins the list too.\r\nAnd the craziest part?\r\nIt all started with bacteria being tired of getting jumped by viruses.`\r\n    },\r\n\t{\r\n      title: \"\",\r\n      date: \"2026-05-13\",\r\n      photos: [\r\n        \"https://scontent.ftlv20-2.fna.fbcdn.net/v/t39.30808-6/696480550_1516476020270284_1514210307011076346_n.jpg?_nc_cat=101&ccb=1-7&_nc_sid=833d8c&_nc_ohc=eSHf_YWMB9AQ7kNvwF2HKXJ&_nc_oc=Adra_WChOAHgagPeyku3FJ7I7cKKJnM5uBG1e5eazrmKmyoevQ71DrPLsVsAFYCXuSxQfynT-5PsupScpKZdw9ey&_nc_zt=23&_nc_ht=scontent.ftlv20-2.fna&_nc_gid=sAeb4nm2aGVRX4xc4DeSmA&_nc_ss=7b2a8&oh=00_Af6Oo4m43Fi-YAUxSc_2RqPGVHvbQPd3mPg_IexzcTRV0w&oe=6A153B2F\",\r\n\t\t\"https://scontent.ftlv20-3.fna.fbcdn.net/v/t39.30808-6/697777789_1516476056936947_1690139933564153127_n.jpg?stp=cp6_dst-jpg_tt6&_nc_cat=105&ccb=1-7&_nc_sid=833d8c&_nc_ohc=7bIUf4DSw-4Q7kNvwHbUMQj&_nc_oc=AdraSkPYAkSFiwpkIgPvF5luZZx0GOQFTHRyEQWlGxm2F-uEAkX1D1GuQnApqGSheZDys6Aw80ia2yxRg5LhqY3-&_nc_zt=23&_nc_ht=scontent.ftlv20-3.fna&_nc_gid=6sx-1cdkGKAZ-i_qnJr0UQ&_nc_ss=7b2a8&oh=00_Af494yDrrsQZFaOlckcQvF3S-0jvmQ6i5GP-m_TjGd18ag&oe=6A155FB9\",\r\n\t\t\"https://scontent.ftlv20-1.fna.fbcdn.net/v/t39.30808-6/697394666_1516476116936941_2987334706626890017_n.jpg?stp=cp6_dst-jpg_tt6&_nc_cat=106&ccb=1-7&_nc_sid=833d8c&_nc_ohc=co8bCBCiLL8Q7kNvwGGK6OL&_nc_oc=Adr7J6HB7DRgxKcOdtgnDJLClsKlEMDw27WEerMOe4Qtozk9OqNk-4xLd2JwhQYlX7Az4-HrJ0x9_VcCnmYOV9nJ&_nc_zt=23&_nc_ht=scontent.ftlv20-1.fna&_nc_gid=suxETTU2Fa7C1SxHn6EyeA&_nc_ss=7b2a8&oh=00_Af5NOJni32IX56CYilox1KlPCWba1lfgrmvLAX3p2pQ3Ag&oe=6A15438D\",\r\n\t\t\"https://scontent.ftlv20-3.fna.fbcdn.net/v/t39.30808-6/699469045_1516476163603603_7856960620586610269_n.jpg?stp=cp6_dst-jpg_tt6&_nc_cat=109&ccb=1-7&_nc_sid=833d8c&_nc_ohc=0P4rw9boNO4Q7kNvwEzxnNn&_nc_oc=AdrfYagd4GhTG7p1K_aGj9oVdQy8W0utmvr1_bLJukCQbcAjZ3mva2fJ2ij01oKgybHWpAWAcwIqaY1m5dYU70MD&_nc_zt=23&_nc_ht=scontent.ftlv20-3.fna&_nc_gid=ni6wmVgPbYlCczDV9gh5sw&_nc_ss=7b2a8&oh=00_Af5Eha5q1FfPdOr5ZinOYTqs4lnLQISDrCukfUN52sSUzg&oe=6A155B55\"\r\n      ],\r\n      content: `“The most successful biological entity on Earth might not even be alive.”\r\n● What Even Is a Virus?\r\nViruses are microscopic infectious particles made of genetic material wrapped inside a protein shell.\r\nThat’s it.\r\nJust biological code with one objective: Replicate.\r\n● Are Viruses Even Alive?\r\nThis is where scientists start fighting\r\nWhy some scientists say viruses are NOT alive:\r\n• They cannot reproduce independently\r\n• They have no metabolism\r\n•They don’t respond to stimuli like cells do\r\n• Outside a host they are inert\r\nWhy others argue they ARE alive:\r\n• They evolve through natural selection\r\n• They mutate\r\n• They adapt extremely fast\r\n• They carry genetic information\r\n• Viruses exist in this weird gray zone between chemistry and life.\r\n• They are like biological pirates: They don’t own ships, they steal yours.\r\n● How Do Viruses Actually Work?\r\nBasic Viral Infection Cycle:\r\n1. Attachment\r\nThe virus recognizes specific receptors on a host cell.\r\nLike a lock and key.\r\nIf the receptor doesn’t match: No infection.\r\nThat’s why many animal viruses cannot infect humans.\r\n2. Entry\r\nThe virus enters the cell or injects its genetic material.\r\n3. Hijacking\r\nThe host cell’s ribosomes start reading viral instructions.\r\nThe cell thinks:\r\n“Ah yes, normal work.”\r\nMeanwhile the virus is basically installing ransomware.\r\n4. Replication\r\nThe cell produces:\r\nViral proteins\r\nViral genomes\r\nNew virus particles\r\nThousands of them.\r\n5. Release\r\nNew viruses burst out or escape the cell.\r\nThen the cycle repeats.\r\nYour body becomes a biological copy machine.\r\n● Why Don’t We Have “Actual Footage” of Viruses?\r\nBecause viruses are absurdly small.\r\nA typical virus is around:\r\n20–300 nanometers\r\nFor comparison:\r\nHuman hair width ≈ 80,000–100,000 nanometers\r\nViruses are literally below the resolution limit of normal light microscopes.\r\nVisible light wavelengths are too large to properly resolve them.\r\nThat’s why scientists use:\r\nElectron microscopes\r\nCryo-electron microscopy\r\nComputer-generated reconstructions\r\n• So when you see those detailed colorful virus images online?\r\nMost are:\r\nScientific renders\r\nReconstructions\r\nColorized electron microscope images\r\nNot regular “camera footage.”\r\nThe famous coronavirus images?\r\nMostly digitally colored electron microscope scans.\r\nBasically: You cannot film viruses the way you film a lion or a shark.\r\nYou’re trying to record something smaller than the wavelength of visible light itself.\r\n● Viruses vs Bacteriophages\r\nA bacteriophage is simply:\r\nA virus that infects bacteria.\r\n“Phage” comes from Greek meaning “to eat.”\r\nThese things look straight-up alien.\r\nLike tiny lunar landers engineered by H.R. Giger.\r\nMain Difference:\r\n▪\uFE0E Virus\r\nInfects animal/plant/fungal cells\r\nOften enters entire cell\r\nShapes vary widely\r\nCan cause human disease\r\n▪\uFE0E Bacteriophage\r\nInfects bacteria\r\nOften injects DNA like a syringe\r\nClassic spider like shape common\r\nUsually harmless to humans\r\nSome bacteriophages are actually being studied as alternatives to antibiotics because they can target dangerous bacteria directly.\r\nWhich is honestly insane: Using viruses to kill bacteria to save humans.\r\n● Viruses force us to question what life even is.\r\nThey are not fully alive.\r\nNot fully dead.\r\nJust instructions searching for machinery.\r\nTiny packets of code capable of:\r\nCrashing civilizations\r\nDriving evolution\r\nReshaping ecosystems\r\nAltering history\r\nHuman empires collapsed because of entities     smaller than dust.\r\nBecause microscopic strands of genetic code learned how to copy themselves efficiently.\r\nThat’s both horrifying and kind of beautiful in a cosmic dark humor way. `\r\n    },\r\n \t{\r\n      title: \"\",\r\n      date: \"2026-04-11\",\r\n      photos: [\r\n        \"https://scontent.ftlv20-1.fna.fbcdn.net/v/t39.30808-6/670656395_1490025266248693_4995218580059019457_n.jpg?_nc_cat=110&ccb=1-7&_nc_sid=833d8c&_nc_ohc=q3Zf_caoDMwQ7kNvwFhO93O&_nc_oc=AdqnEvpJED7zlVEAEOLBCokKUy9ZUJEWusSMTk3xvgEZz3e7Qxxo-SIJ7MaMuCkvqYMYf20d1iIAMeReenjZpqKO&_nc_zt=23&_nc_ht=scontent.ftlv20-1.fna&_nc_gid=X4RsAb8g_EeSESLJEeSmvg&_nc_ss=7b2a8&oh=00_Af4SBSwCjL6D8peU7yNZ4clPuwGxSmciCSUhhXlsWpEp3Q&oe=6A1549FC\",\r\n\t\t\"https://scontent.ftlv20-3.fna.fbcdn.net/v/t39.30808-6/671742806_1490025302915356_4058807635074793416_n.jpg?_nc_cat=103&ccb=1-7&_nc_sid=833d8c&_nc_ohc=ZgVWsj-chPkQ7kNvwHwsJn7&_nc_oc=AdpauTUHcCgqtG5Jz9zMd7Mk5XruzA-7cMvOipp4NaCcUo84gIzTubkClnThDthShFtn9tZVKkO8BeaO7hkHxyT8&_nc_zt=23&_nc_ht=scontent.ftlv20-3.fna&_nc_gid=X3IFQd9vg-Ve_jqH3Qb5bA&_nc_ss=7b2a8&oh=00_Af6hFFncFjn2NwjQ5iHyVtOU5lQT2wTQB_3HQODlbnNwRw&oe=6A1550A8\",\r\n\t\t\"https://scontent.ftlv20-3.fna.fbcdn.net/v/t39.30808-6/669680728_1490025346248685_628221016719826846_n.jpg?_nc_cat=105&ccb=1-7&_nc_sid=833d8c&_nc_ohc=_NqXBXpIv7sQ7kNvwETLltU&_nc_oc=AdpY3i6GfHrEROLDJHa4XK3JVJrOOWLkKYZeYBMXgquA8BCyPXYX3q7SMF82ZdfacVHCe-CXpQXM2mSDrckpOIne&_nc_zt=23&_nc_ht=scontent.ftlv20-3.fna&_nc_gid=wgjJfub-sHrWmS6zcNkUag&_nc_ss=7b2a8&oh=00_Af4Eta1PRrgwHIotfyDu-IB5AkWrtU7-HZ8ACxIrI-_cbQ&oe=6A154DEC\",\r\n\t\t\"https://scontent.ftlv20-3.fna.fbcdn.net/v/t39.30808-6/670482885_1490025396248680_8143723292938525762_n.jpg?_nc_cat=109&ccb=1-7&_nc_sid=833d8c&_nc_ohc=5Sp80MPnqO0Q7kNvwEtSuCW&_nc_oc=Adr--S_Ce9KX3htFBHJxVZTBTvZFINgqaSSKu3IXDnUowBp4MbFDmK46Q5UyDQNHNRDLNizUilLzEFcFD4fw6Q0H&_nc_zt=23&_nc_ht=scontent.ftlv20-3.fna&_nc_gid=8HQNjl1J0eb90Q0kR_u93Q&_nc_ss=7b2a8&oh=00_Af6a_p3SS-liojsh-pnZsuMvkNAW2qSx4ZvLUQSGTfDe5w&oe=6A154695\",\r\n\t\t\"https://scontent.ftlv20-1.fna.fbcdn.net/v/t39.30808-6/670890620_1490025426248677_6938520008894139122_n.jpg?_nc_cat=106&ccb=1-7&_nc_sid=833d8c&_nc_ohc=cJZhPLWcjoMQ7kNvwG3WI-I&_nc_oc=Adp7hR2CJDBD8gD4CtKbk0FUpbTms6A-w-Fq4oEWjkBlSrWsg-xmX6ZQFdt-UwIh4JR7j5PFOu3vg7YpfRSEaXDK&_nc_zt=23&_nc_ht=scontent.ftlv20-1.fna&_nc_gid=0Z1ByqCZVPWGB7H2RADK2A&_nc_ss=7b2a8&oh=00_Af65ci-n7I1lzmTzHJFryWC9PJ35hKu5roKChBJNwOu7KQ&oe=6A1532B6\",\r\n\t\t\"https://scontent.ftlv20-2.fna.fbcdn.net/v/t39.30808-6/671593606_1490025459582007_5261208897729962169_n.jpg?_nc_cat=104&ccb=1-7&_nc_sid=833d8c&_nc_ohc=LOLg2MknFYcQ7kNvwF965Er&_nc_oc=AdpUvBYkjkvp1wOdcfN0Bh63YhLgE_fYdlGU0qxLkgEAeBWCxW7AmiOVf44HTMVV2lx4FIZXDSZfzWiRLNMgyD8r&_nc_zt=23&_nc_ht=scontent.ftlv20-2.fna&_nc_gid=ZQOPW6DhEvCC9yFSBIgl3g&_nc_ss=7b2a8&oh=00_Af6oELVdRH15_2N5C5Ss-7kTNzWWJ_KHh5Ua9vd0xgryNA&oe=6A154042\"\r\n      ],\r\n      content: `● Just as governments can face internal revolutions when certain groups reject the laws that keep society stable, the human body can experience its own biological uprising.\r\n● Cancer begins when a normal cell stops obeying the regulatory systems that maintain order inside the body.\r\nEvery healthy cell is programmed to follow strict biological rules: when to grow, when to divide, when to repair itself, and when to die.\r\nA cancer cell is, in essence, a rebel cell, one that breaks away from collective control.\r\nInstead of cooperating with the organism, it begins acting only for its own survival: ignoring signals to stop dividing, resisting death, consuming resources excessively, and eventually invading neighboring tissues.\r\nWhat starts as one rebellious cell can become a growing population of rogue cells, forming tumors and, in advanced stages, spreading to distant organs through metastasis.\r\nIn biological terms, cancer is not chaos from outside, it is betrayal from within.\r\n● How Cancer Begins\r\nCancer is caused by accumulated mutations in DNA that damage the genes responsible for regulating cell behavior.\r\nThese mutations may result from:\r\n• Smoking and carcinogens\r\n• Radiation exposure (UV, X-rays)\r\n• Certain viruses such as HPV or hepatitis B/C\r\n• Chronic inflammation\r\n• Inherited genetic mutations\r\n• Random replication errors during cell division\r\nWhen critical genes fail, especially oncogenes and tumor suppressor genes like p53, cells escape regulation.\r\n● The Oxygen Paradox: Why Cancer Thrives in Low Oxygen Environments?\r\nMost healthy cells rely on oxygen-dependent mitochondrial respiration for efficient energy production.\r\n C₆H₁₂O₆ + 6O₂ -> 36ATP + 6CO₂+ 6H₂O\r\nCancer cells often abandon this efficient system and switch to a faster but wasteful pathway called:\r\nThe Warburg Effect\r\nEven when oxygen is present, many cancer cells prefer glycolysis:\r\n C₆H₁₂O₆ -> 2 ATP + 2 lactate\r\nThis produces less ATP, but much faster.\r\nThat speed supports rapid growth and division.\r\nWhy This Helps Cancer\r\nThis metabolic switch allows cancer cells to:\r\n• Generate energy quickly\r\n• Produce building blocks for new cells faster\r\n• Survive in hypoxic tumor cores\r\n• Acidify surroundings with lactate, aiding invasion\r\nTumors often outgrow their blood supply, creating low-oxygen zones where normal cells fail, but cancer cells adapt.\r\n● Critical Scientific Note\r\nLow oxygen does not directly cause cancer.\r\nCancer is fundamentally driven by DNA mutations.\r\nHypoxia simply creates an environment where aggressive cancer cells gain an advantage.\r\n● some people think that cutting sugar completely kills cancer but does it work?\r\nShort answer: No, cutting sugar does not “starve” cancer.\r\nThat idea gets thrown around a lot online, but biologically it’s oversimplified and kind of bogus when stated that way.\r\nWhy?\r\n○ Cancer cells do consume a lot of glucose, yes. Because they divide rapidly, they burn fuel like a startup burning investor cash.\r\nBut here’s the catch:\r\n• All your normal cells also need glucose, especially the brain, red blood cells, and muscles.\r\n• Even if you stop eating sugar completely, your body is not stupid, it will manufacture glucose from proteins and fats through gluconeogenesis.\r\n• So blood glucose never just drops to zero unless something is catastrophically wrong.\r\n○ What Actually Happens If You Cut Sugar?\r\nReducing excess refined sugar can still help indirectly:\r\n• Lowers obesity risk\r\n• Reduces chronic inflammation\r\n• Improves insulin regulation\r\n• May lower risk factors for some cancers\r\nObesity and high insulin levels are linked with increased risk for cancers like:\r\nbreast, colon, pancreatic, and endometrial cancer.\r\nSo:\r\nCutting excessive sugar may reduce cancer risk,\r\nbut it does not selectively kill existing cancer cells.\r\n○ Why Cancer Still Survives?\r\nCancer cells are metabolically flexible little bastards.\r\nIf glucose is scarce, many can switch to:\r\n• Amino acids (like glutamine)\r\n• Fatty acids\r\n• Ketone-related metabolic pathways in some cases\r\nThey adapt. That’s why cancer treatment is far more complex than “just don’t eat sugar.”\r\n●  Real Clinical Reality\r\nActual cancer treatment targets include:\r\n• Surgery\r\n• Chemotherapy\r\n• Radiation\r\n• Immunotherapy\r\n• Targeted metabolic drugs\r\nResearchers are studying metabolic therapies, but no credible oncology system says sugar elimination alone cures cancer.`\r\n    },\r\n\r\n\t{\r\n      title: \"\",\r\n      date: \"2026-04-09\",\r\n      photos: [\r\n        \"https://scontent.ftlv20-3.fna.fbcdn.net/v/t39.30808-6/668452613_1488630926388127_3195279418291340541_n.jpg?stp=cp6_dst-jpg_tt6&_nc_cat=105&ccb=1-7&_nc_sid=833d8c&_nc_ohc=yBYLfG9bos4Q7kNvwEJL8K4&_nc_oc=AdoZESejqf8-E_WVtvF2ylUd_DzvpviCdkvnHVBN44z1AFrX3rLfEP03QOePlueypsbH4gfL7ReKdQOM6XPuoGUU&_nc_zt=23&_nc_ht=scontent.ftlv20-3.fna&_nc_gid=7oIRfZ9aT3SyZQrgurMbQg&_nc_ss=7b2a8&oh=00_Af65lDSM0aqDoHB3UbGqgpGrhB9ZhulVx2wYTqWG4j0dPw&oe=6A15634E\",\r\n      \"https://scontent.ftlv20-3.fna.fbcdn.net/v/t39.30808-6/669728946_1488630963054790_34997885123151811_n.jpg?stp=cp6_dst-jpg_tt6&_nc_cat=108&ccb=1-7&_nc_sid=833d8c&_nc_ohc=20m3L6F9meMQ7kNvwHMIRJV&_nc_oc=AdoAkssbr-u_VAtPXoUHA9jr0Bwfvq4jk68Us89zAES1B0vsZXg17ZZXiTeJPp-W1_HoDYOzqzuZXRc5ZMWGfyT3&_nc_zt=23&_nc_ht=scontent.ftlv20-3.fna&_nc_gid=wfwE4qU5k7E6dGVUIUcL1w&_nc_ss=7b2a8&oh=00_Af7hnl99qiMGdRN5k7d85SOC2LD4-46LWqpqoXQVAeG08w&oe=6A155C04\",\r\n      \"https://scontent.ftlv20-1.fna.fbcdn.net/v/t39.30808-6/668924146_1488630989721454_177417812559069825_n.jpg?stp=cp6_dst-jpg_tt6&_nc_cat=106&ccb=1-7&_nc_sid=833d8c&_nc_ohc=SlmNP6d5x9kQ7kNvwGJUGaq&_nc_oc=Adp3yzVCbrgXnlI1-RF-intH1y1gPB7n-HA9QeVDADLoONtld96qIywy09TqbkupexQe3ATiYjKsI3DxkeS4LrSs&_nc_zt=23&_nc_ht=scontent.ftlv20-1.fna&_nc_gid=2cF24K2Q-Bt6VI0m5PM1ig&_nc_ss=7b2a8&oh=00_Af49s2WxevHz5vpC5kuDDUecTaw-IUvIvUPSXk0sIKlVVA&oe=6A154A8B\",\r\n      \"https://scontent.ftlv20-3.fna.fbcdn.net/v/t39.30808-6/669678734_1488631033054783_1531655127534970101_n.jpg?stp=cp6_dst-jpg_tt6&_nc_cat=105&ccb=1-7&_nc_sid=833d8c&_nc_ohc=1CMJk7sQQhIQ7kNvwHeSJhs&_nc_oc=AdqTpy7HDNyLU5c04zCo9m4LUDPA1orjOgJ5V4DH3jCpASvr3FoeXAMXbmJ-IMKG2C6OY3MYns6ff1a5svhee2Zc&_nc_zt=23&_nc_ht=scontent.ftlv20-3.fna&_nc_gid=NtmC4YvVKsp40-W_o_R8Kw&_nc_ss=7b2a8&oh=00_Af4w7euOh6FBlIzSahiceoUtxGBAq46wpviopmFnLitzTg&oe=6A1564BC\",\r\n      \"https://scontent.ftlv20-2.fna.fbcdn.net/v/t39.30808-6/668898626_1488631076388112_3541126093808072652_n.jpg?stp=cp6_dst-jpg_tt6&_nc_cat=101&ccb=1-7&_nc_sid=833d8c&_nc_ohc=eli1rNa6kxAQ7kNvwHe08B6&_nc_oc=Adrhe5PUxamZR1IhuRCu1RwBRdMIBK8Xq0K9XLeglKu8N3L-78fsfAcnpa6RaniOi5J57tjI7sHB_7IerwqImd78&_nc_zt=23&_nc_ht=scontent.ftlv20-2.fna&_nc_gid=EHtP1HXthtXiRfkdKL8tqA&_nc_ss=7b2a8&oh=00_Af5hG7cbq09_h8zdmdDAXANo9ARpwrU19Qg13QnGFNuBaQ&oe=6A1534DB\",\r\n      \"https://scontent.ftlv20-2.fna.fbcdn.net/v/t39.30808-6/668729900_1488631119721441_6618073364117385189_n.jpg?stp=cp6_dst-jpg_tt6&_nc_cat=104&ccb=1-7&_nc_sid=833d8c&_nc_ohc=4f_qpPaFc38Q7kNvwFkgA39&_nc_oc=AdrPccolif2s0yHqq83B21VmnrXYLNHePb7vSXUOTCIvqJbiQpYxB9kzkqT9Y1F5fqIueb_wlnbBnRO1NgrtZMSc&_nc_zt=23&_nc_ht=scontent.ftlv20-2.fna&_nc_gid=HvzcSKPNGDmi1ycpmCkfYg&_nc_ss=7b2a8&oh=00_Af460dMx8RMT8VyUcovsXST4jLexKAB8PxJizBIbKLVD5A&oe=6A154A21\",\r\n      \"https://scontent.ftlv20-2.fna.fbcdn.net/v/t39.30808-6/667876305_1488631166388103_7714172820947777341_n.jpg?stp=cp6_dst-jpg_tt6&_nc_cat=101&ccb=1-7&_nc_sid=833d8c&_nc_ohc=Df4zR3uO9roQ7kNvwHnizSQ&_nc_oc=AdodawAnDlybD7DKK_AYviK2ijl3Ot1GdwfC-DL1HM8hDgD4SAhEflWWR2GW2UYhQxz2tYDPwNbquqdaVZ4z8Y-w&_nc_zt=23&_nc_ht=scontent.ftlv20-2.fna&_nc_gid=x-ttYU_0S0weROmiZ0u27Q&_nc_ss=7b2a8&oh=00_Af4EGq8vhvsrFQjUrTHoNISFYggnZXFuvmYq2hs46XA1cA&oe=6A155BF6\",\r\n      \"https://scontent.ftlv20-2.fna.fbcdn.net/v/t39.30808-6/669058762_1488631199721433_8508185089567549858_n.jpg?stp=cp6_dst-jpg_tt6&_nc_cat=101&ccb=1-7&_nc_sid=833d8c&_nc_ohc=THBrYPNNmz4Q7kNvwGLezLX&_nc_oc=AdppsZ_-mZ-AJcMgAELeHPDBn1iriAmDSPlJyaPeX8dpx5mWKUVrkPNJ0Tr2OY6HLuL-Lmz4pU5aaPO6WIWkWP09&_nc_zt=23&_nc_ht=scontent.ftlv20-2.fna&_nc_gid=O_lB1PcM2JYy0bfpzlw83A&_nc_ss=7b2a8&oh=00_Af6L4JHFXebe2lU78s_dD_iUftVS9FUL5BC1vDbkcV7KYA&oe=6A155DFD\",\r\n      \"https://scontent.ftlv20-3.fna.fbcdn.net/v/t39.30808-6/668924649_1488631273054759_5233444311218835774_n.jpg?_nc_cat=108&ccb=1-7&_nc_sid=833d8c&_nc_ohc=GB8_Avf6W_8Q7kNvwGW4Lbl&_nc_oc=Adq5WdmOdO1KHzxYuAuQn6Y7JSKSe7n_YQHR5janAgcjVDRoIhYpr0bYx33alDwxhdQrcgfqJvzQ1ftHnt1yMNTj&_nc_zt=23&_nc_ht=scontent.ftlv20-3.fna&_nc_gid=tnSeE8wi1aEu7YC3xGmG3A&_nc_ss=7b2a8&oh=00_Af4t80hh0ey6INxkTUWjzHDY1wJJnMCiyZ4C2VRMFALiIg&oe=6A154430\"\r\n      ],\r\n      content: `Your body is fighting a war every second and most people have no idea how.\r\nThe human immune system operates through layered defense mechanisms, each with a specific role in identifying and eliminating pathogens.\r\n● 1. First Line of Defense (Physical & Chemical Barriers):\r\nThese defenses prevent pathogens from entering the body:\r\n• Skin → physical barrier\r\n• Mucus & cilia → trap and remove microbes\r\n• Stomach acid (HCl) → destroys ingested pathogens\r\n• Enzymes (e.g., lysozyme in tears/saliva) → break down bacterial walls\r\n● 2. Innate Immunity (Non-Specific Immediate Response):\r\nActivated when pathogens bypass the first line of defense.\r\nThis system responds within minutes to hours:\r\n○ Physical & Early Recognition\r\n• Epithelial barriers → first interaction with invading microbes\r\n• Dendritic cells → detect pathogens and initiate immune signaling\r\n○ White Blood Cells (Leukocytes)\r\n• Neutrophils & macrophages → phagocytosis (engulf and destroy pathogens)\r\n• Natural Killer (NK) cells → destroy infected or abnormal cells\r\n○ Soluble Components\r\n• Complement system → enhances pathogen destruction and opsonization\r\n• Natural antibodies → provide immediate, non-specific recognition\r\n○ Inflammatory Response\r\n• Increased blood flow, heat, and swelling, which recruit immune cells to the site of infection.\r\nThis stage is non-specific (same response to many pathogens).\r\n● 3. Adaptive Immunity (Specific & Long-Term Response):\r\nActivated when innate immunity is insufficient.\r\nAn antigen is any molecule recognized by the immune system as foreign (often found on pathogens).\r\n○ T Cells\r\n• Helper T cells (CD4⁺) → coordinate immune response\r\n• Cytotoxic T cells (CD8⁺) → kill infected cells\r\n○ B Cells\r\n• Differentiate into plasma cells\r\n• Produce antibodies specific to the antigen\r\n○ Immunological Memory\r\n• Memory B and T cells remain after infection\r\n• Faster and stronger response upon        re-exposure\r\n This is why vaccines work.\r\n● What protects individuals can reshape entire populations.\r\nWhen Immunity Becomes a Historical Force:\r\nFollowing European arrival in the Americas (15th–16th centuries):\r\nPopulations were exposed to novel pathogens:\r\n• Smallpox\r\n• Measles\r\n• Influenza\r\nIndigenous populations had:\r\n• No prior exposure\r\n• No immunological memory\r\n• High susceptibility\r\nMortality rates reached 50–90% in some regions.\r\nThis was not intentional biological warfare in most cases, but the epidemiological impact was catastrophic.\r\n● North Sentinel Island\r\nThe Sentinelese are one of the last uncontacted populations.\r\nTheir condition:\r\n• Long-term geographic isolation\r\n• No exposure to global pathogens\r\n• No prior adaptive immunity to many global infectious diseases\r\nEven mild infections (e.g., influenza, measles) could be fatal.\r\n○ For this reason, the Government of India enforces strict exclusion laws:\r\n• No travel within ~5 km of the island\r\n• No contact allowed\r\n• Violations are illegal\r\nThis is a public health protection strategy, not just cultural preservation. `\r\n    },\r\n\r\n\t{\r\n      title: \"\",\r\n      date: \"2026-03-29\",\r\n      photos: [\r\n        \"https://scontent.ftlv20-1.fna.fbcdn.net/v/t39.30808-6/659685234_1479366353981251_4469725300374034138_n.jpg?stp=cp6_dst-jpg_tt6&_nc_cat=110&ccb=1-7&_nc_sid=833d8c&_nc_ohc=YPq0bq0t0KsQ7kNvwE_rq7f&_nc_oc=Ado0BkuvlCIogXV6zKVrCNDt-sQTByslhlZa4pP-jIsyMPJsDT33Yt1LfEJqvEEroA2gC7T3FO9zbLnWnoxVd9jM&_nc_zt=23&_nc_ht=scontent.ftlv20-1.fna&_nc_gid=bzMiY1GShl42W_JNo6HM1A&_nc_ss=7b2a8&oh=00_Af7ku5NABZiR_o0gau5lJjJl48DTxpQ-XC0nj4zMmlB5tA&oe=6A153A97\",\r\n        \"https://scontent.ftlv20-2.fna.fbcdn.net/v/t39.30808-6/657693263_1479366387314581_7564316737585585596_n.jpg?stp=cp6_dst-jpg_tt6&_nc_cat=104&ccb=1-7&_nc_sid=833d8c&_nc_ohc=4k4s8dkvxa8Q7kNvwF61__X&_nc_oc=AdqLP_AiYlUJUmyq3tXDa9cSX_nMzwV6VdEL_G7WFb3sRVmjkZKPX4mwDjd9tRoL-N8yGIPmrsQi6OSSbXGpM4U7&_nc_zt=23&_nc_ht=scontent.ftlv20-2.fna&_nc_gid=m9Pb2cDYICbaEPM_FO_EKg&_nc_ss=7b2a8&oh=00_Af7JAu44cfl772xinI2oBB89BG3XtK0zf6dR7g5Q-8_k3A&oe=6A153359\",\r\n        \"https://scontent.ftlv20-1.fna.fbcdn.net/v/t39.30808-6/659743862_1479366430647910_1659619112778718193_n.jpg?stp=cp6_dst-jpg_tt6&_nc_cat=107&ccb=1-7&_nc_sid=833d8c&_nc_ohc=484PLJ0cN2oQ7kNvwGCM4d3&_nc_oc=AdqnBe2RfOVAH69UB5u7P8d6ebMO1rAGxnIHxQqYnpyyA5cLaea4VgJ81UXCteoqDe6qI5xikruJxwken89pNlGl&_nc_zt=23&_nc_ht=scontent.ftlv20-1.fna&_nc_gid=GvG74yZZOQtxlBl40JlW8g&_nc_ss=7b2a8&oh=00_Af7tVXRCvZDAAWtgj0vL7FBjDoVhFI_ja7zjAqbNubvB-Q&oe=6A1542E6\",\r\n        \"https://scontent.ftlv20-3.fna.fbcdn.net/v/t39.30808-6/657518590_1479366493981237_3104180475265545058_n.jpg?stp=cp6_dst-jpg_tt6&_nc_cat=105&ccb=1-7&_nc_sid=833d8c&_nc_ohc=-bJComOq8d0Q7kNvwE6I7kX&_nc_oc=AdrCaNA3Ly4GOUR27T9VFyigKOv02dZ0NSZE5qivyeMxByIo3io-0JLiyJIP3r0CoqXAPV6JBLrsceuTBkDHE-Pc&_nc_zt=23&_nc_ht=scontent.ftlv20-3.fna&_nc_gid=Hyci7u7K9rt85J2VjVl_dA&_nc_ss=7b2a8&oh=00_Af4odyZGQqbEszcYDAimlrk2QD16cfNE4ErZxbQHeVlJ3Q&oe=6A1531DA\",\r\n        \"https://scontent.ftlv20-1.fna.fbcdn.net/v/t39.30808-6/658149551_1479366527314567_3729529593510541454_n.jpg?stp=cp6_dst-jpg_tt6&_nc_cat=111&ccb=1-7&_nc_sid=833d8c&_nc_ohc=SgMNZs2bFiMQ7kNvwFK1VGN&_nc_oc=Adpeka3Zj7K7PrFxfkhtrwV31KSNYf-RooObyad8_EjkVKKu2LXrNEQziAGBqnIIJshNStjIWaf0ZedguFZwCIx9&_nc_zt=23&_nc_ht=scontent.ftlv20-1.fna&_nc_gid=8JQO1JgegWYGCCH_JxRyAQ&_nc_ss=7b2a8&oh=00_Af4mKn1kklJUus1sHBPgMp925Z02ofTYdNiMNwNkeXncXg&oe=6A153EC1\"\r\n      ],\r\n      content: `“Older men declare war. But it is the youth that must fight and die.”\r\n— Herbert Hoover\r\n● From a biological perspective, war is not something uniquely human.\r\nIt is a behavior we share with other species,  just more destructive.\r\nIn ecology, ecological interactions/relationships between organisms are well defined:\r\n1) Mutualism\r\nBoth organisms benefit (+/+).\r\n• Bees and flowers\r\n• Clownfish and sea anemones\r\nCooperation leads to survival, growth, and stability.\r\n○ Human version:\r\nTrade, scientific collaboration, medical and technological progress.\r\n2) Commensalism\r\nOne benefits, the other is unaffected (+/0).\r\n• Remora fish riding sharks\r\n• Birds feeding near large animals\r\nNo harm, no real cost.\r\n○ Human version:\r\nSmaller economies benefiting from larger ones, systems where one side gains without damaging the other.\r\n3) Parasitism\r\nOne benefits at the expense of the other (+/-).\r\n• Parasites feeding on hosts\r\n• Ticks draining blood\r\nSurvival through exploitation.\r\n○ Human version:\r\nSystems where a few benefit while others carry the cost.\r\nEconomic and political structures that drain populations.\r\n4) Predation\r\nOne survives by eliminating the other (+/-).\r\n• Lions hunting zebras\r\n• Eagles catching prey\r\nSurvival through destruction.\r\n○ Human version:\r\nWar.\r\nTotal domination justified as necessity.\r\n5) Competition\r\nBoth sides lose energy fighting over the same resource (-/-).\r\n• Deer clashing antlers\r\n• Animals fighting over territory\r\nEven the “winner” is weakened.\r\n○ Human version:\r\nArms races, economic conflicts, wars that drain both sides.\r\n● So what are we doing?\r\nWe are capable of mutualism.\r\nYet we repeatedly choose competition, predation, and parasitism.\r\n• Economies strain\r\n• People suffer\r\n• Stability collapses\r\n• Generations carry trauma\r\nEven the “winner”:\r\n• Loses lives\r\n• Loses resources\r\n• Loses time\r\nSo what exactly is winning?\r\n● In nature, the most successful systems are not the most aggressive.\r\nThey are the most balanced.\r\nMaybe intelligence isn’t about domination,\r\nbut about choosing cooperation over destruction.\r\nBecause right now,\r\nwe are not acting like an advanced species.\r\nWe are behaving exactly like organisms fighting over limited resources just with better weapons`\r\n    },\r\n\r\n\t{\r\n      title: \"\",\r\n      date: \"2026-03-06\",\r\n      photos: [\r\n        \"https://scontent.ftlv20-1.fna.fbcdn.net/v/t39.30808-6/648932930_1461008959150324_888456949918107212_n.jpg?_nc_cat=107&ccb=1-7&_nc_sid=833d8c&_nc_ohc=80e0D5rln1YQ7kNvwFiMvAS&_nc_oc=AdrsK-kWS2XKfh-Jqx4b8sibD2SageZgdk0eqYVgGN8qusvZj9f2i-soaw0WltXV4zc-LkH_T7Vj6jUIFz9ASlci&_nc_zt=23&_nc_ht=scontent.ftlv20-1.fna&_nc_gid=wy_IMas3fb4Ayta39oDqVg&_nc_ss=7b2a8&oh=00_Af5MjAOeqqOoXBIG94s1l7pLvfRQCct9nubEHXy_XTg_ig&oe=6A164A9A\",\r\n\t\t\"https://scontent.ftlv20-2.fna.fbcdn.net/v/t39.30808-6/648227234_1461009015816985_7085303653941571384_n.jpg?stp=cp6_dst-jpg_tt6&_nc_cat=104&ccb=1-7&_nc_sid=833d8c&_nc_ohc=iykzw5KN7e4Q7kNvwG4PLXh&_nc_oc=AdqHqdHbo5YUBnjip6EJTXAoZeQGubmecIfJRyzQ4o_PI7KlbppLkz4PCuia1VVb8p3RTNpbcq9IR7o7jGRUT-0K&_nc_zt=23&_nc_ht=scontent.ftlv20-2.fna&_nc_gid=RZsWAtOZ0mAsJdtcW6ormA&_nc_ss=7b2a8&oh=00_Af4Yy43DZaEcxJ5Q96ZJRSXNs-_sz4oOoFhvDSHqtzbImA&oe=6A1625F0\",\r\n\t\t\"https://scontent.ftlv20-3.fna.fbcdn.net/v/t39.30808-6/648110622_1461009062483647_6454857814971800811_n.jpg?stp=cp6_dst-jpg_tt6&_nc_cat=109&ccb=1-7&_nc_sid=833d8c&_nc_ohc=g8Owc68rIcsQ7kNvwFHeRDL&_nc_oc=AdrYjR0iJQJF_2dn7l2YwC8-LpR4psWcy13Emk_8tG0K4aT3YzWLd9VShdIDcmAXkmMFq2Lh3wNO4LRWUO1zfzUy&_nc_zt=23&_nc_ht=scontent.ftlv20-3.fna&_nc_gid=iLDSfmHkQpJYqpoHSIn5JQ&_nc_ss=7b2a8&oh=00_Af4_9i2dmfjONwVeXkVEr9HQjKp4pwx6m_CblJ1-Deh9BA&oe=6A165030\",\r\n\t\t\"https://scontent.ftlv20-2.fna.fbcdn.net/v/t39.30808-6/648235932_1461009102483643_8921730724759370631_n.jpg?stp=cp6_dst-jpg_tt6&_nc_cat=102&ccb=1-7&_nc_sid=833d8c&_nc_ohc=WZvFhZhwS8EQ7kNvwHphYM9&_nc_oc=AdrcPaVgUoQEQPJhJs8yE7lKhLzK6Sv-H3y4N7X7k-JCmkXeJdEWthWxagBCcEDmiw3PS3Yc4E2x7lHO5eT_s9uW&_nc_zt=23&_nc_ht=scontent.ftlv20-2.fna&_nc_gid=fIKA0jAmMiTLRMuAeu0cBA&_nc_ss=7b2a8&oh=00_Af5l6aFEDoxQdgx-7_6wCW1eKNQ-BJEezIL_SXQk5x_vKg&oe=6A1656B7\",\r\n\t\t\"https://scontent.ftlv20-3.fna.fbcdn.net/v/t39.30808-6/647284754_1461009149150305_3158920022225267873_n.jpg?_nc_cat=108&ccb=1-7&_nc_sid=833d8c&_nc_ohc=yIrt6ezRRXEQ7kNvwGyi5C5&_nc_oc=AdoelhrXCxlAwZdmzaC1nhgop8k4LzhxwOtOb9zypjLth3i9uo6mb3WD6r_XuM_6Js4uklHk_zcBpMVLc4RLy0sa&_nc_zt=23&_nc_ht=scontent.ftlv20-3.fna&_nc_gid=YAtaB51sLCUVF0lkt8pC1Q&_nc_ss=7b2a8&oh=00_Af4yzesBnZpe6vHbUH7YVB30mR6t7JWi-nQra8fTi3Fwtg&oe=6A1655A9\"\r\n\r\n\t\t],\r\n      content: `“There are no facts, only interpretations.”\r\n— Friedrich Nietzsche\r\n● We often assume humans experience reality in the same way: same senses, same thoughts, same perception.\r\nBut neuroscience suggests something very different.\r\nSmall neurological variations mean that two people can experience the same moment in completely different ways.\r\nHere are a few fascinating examples:\r\n1. The Inner Monologue\r\nSome people constantly hear a voice in their head narrating their thoughts.\r\nOthers don’t.\r\nResearch using experience sampling methods by psychologist Russell Hurlburt suggests that many people experience little or no internal speech during thinking.\r\nInstead of words, their thoughts may appear as:\r\n• abstract concepts\r\n• visual imagery\r\n• emotional impressions\r\n• intuitive understanding\r\nThe neuroscience\r\nInner speech activates the brain’s language network:\r\n• Broca’s area (speech production)\r\n• Wernicke’s area (language comprehension)\r\n• parts of the Default Mode Network\r\nWhen people rely less on internal speech, thinking tends to recruit more activity in:\r\n• visual cortex\r\n• parietal regions involved in spatial reasoning\r\n• sensorimotor networks\r\nIn simple terms:\r\nSome brains think in language,\r\nothers think in images or raw concepts.\r\n2. Hearing Someone’s Voice When Reading Their Message\r\nWhen you read a message from someone you know, do you hear it in their voice?\r\nSome people do.\r\nOthers simply read silently with no auditory simulation.\r\nThis phenomenon involves auditory imagery, where the brain recreates sounds internally.\r\nThe neuroscience\r\nEven without actual sound, the brain activates regions involved in hearing:\r\n• Superior temporal gyrus (auditory cortex)\r\n• the phonological loop in working memory\r\n• voice-memory networks in the temporal lobe\r\nYour brain is essentially simulating the speaker’s voice from stored memory patterns.\r\nSo two people reading the same message may have completely different internal experiences.\r\nOne hears a voice.\r\nThe other reads silent symbols.\r\n3. What You See When You Close Your Eyes\r\nClose your eyes.\r\nSome people see pure darkness.\r\nOthers see:\r\n• flickering lights\r\n• moving dots\r\n• geometric patterns\r\n• visual “static”\r\nThis phenomenon is often related to phosphene activity.\r\nThe neuroscience\r\nEven in total darkness the visual system never fully shuts down.\r\nSpontaneous neural activity continues in:\r\n• retinal cells\r\n• the lateral geniculate nucleus (LGN)\r\n• the primary visual cortex (V1)\r\nThis background activity creates a faint internal visual field sometimes called Eigengrau — the brain’s intrinsic “dark gray”.\r\nIn other words, your brain can generate visual signals even when nothing is there.\r\n4. Aphantasia vs Hyperphantasia\r\nAsk someone to imagine an apple.\r\nSome people see a clear mental image.\r\nOthers see nothing at all.\r\nThe inability to form mental images is known as aphantasia.\r\nAt the opposite extreme is hyperphantasia, where mental images can be extremely vivid.\r\nThe neuroscience\r\nMental imagery depends on communication between:\r\n• prefrontal cortex\r\n• visual cortex\r\n• hippocampus\r\nStrong connectivity produces vivid mental images.\r\nWeaker connectivity results in conceptual thinking without visual imagery.\r\nSo when someone says:\r\n“Picture this in your mind.”\r\nThere is a real possibility that your brain literally cannot.\r\n5. Pure Abstract Thinkers\r\nSome people have no inner voice and no visual imagery.\r\nThey do not hear words.\r\nThey do not see images.\r\nYet they still think.\r\nThese individuals rely on what researchers call unsymbolized thinking, thoughts that exist as raw meaning without language or mental imagery.\r\nThe neuroscience\r\nThis form of cognition likely relies heavily on:\r\n• prefrontal cortex abstraction networks\r\n• parietal association cortex\r\n• large scale conceptual processing systems\r\nInstead of translating ideas into words or pictures, the brain processes pure semantic structures.\r\nThought exists before language appears.\r\n6. Thinking About Thinking\r\nAnother difference between people is metacognition-the ability to think about one's own thinking.\r\nSome people constantly monitor their thoughts:\r\nThey analyze their reasoning.\r\nQuestion their assumptions.\r\nObserve their own mental processes.\r\nOthers simply think and act without this additional layer of reflection.\r\nThe neuroscience\r\nMetacognition is strongly linked to activity in the prefrontal cortex, especially:\r\n• anterior prefrontal cortex (BA10)\r\n• dorsolateral prefrontal cortex\r\nThese regions help the brain evaluate its own cognitive processes, essentially allowing the mind to observe itself.\r\nThis is why some individuals naturally engage in deep self reflection, while others rarely question how their own thoughts are formed.\r\n● Same species but wired differently.\r\nDifferent neural architectures.\r\nDifferent internal realities.\r\nAnd the strangest part is this:\r\nYou will never fully know how another person’s mind experiences the world.`\r\n    },\r\n\r\n\t{\r\n      title: \"\",\r\n      date: \"2026-02-20\",\r\n      photos: [\r\n        \"https://scontent.ftlv20-2.fna.fbcdn.net/v/t39.30808-6/639530198_1449458890305331_1266293927328370909_n.jpg?stp=cp6_dst-jpg_tt6&_nc_cat=104&ccb=1-7&_nc_sid=833d8c&_nc_ohc=VWaXE3JgyqoQ7kNvwHs6wIj&_nc_oc=Adq4YBlUwWaJx7DkBOPI8bq10_mEHi7f7_Vy8Y-dHKMqJQ_Yqb7JYGEsU3gvrBtB_713L34k0e88eLrqpeFSG9b7&_nc_zt=23&_nc_ht=scontent.ftlv20-2.fna&_nc_gid=dEpTAn6jpY_vw1-F2eKwog&_nc_ss=7b2a8&oh=00_Af5bbZjFF9qxACBrWsOitObGCAykkUpo7Fl4r1V4ZfKRcw&oe=6A164E9F\",\r\n\t\t\"https://scontent.ftlv20-1.fna.fbcdn.net/v/t39.30808-6/637892745_1449458933638660_2950119683615042965_n.jpg?stp=cp6_dst-jpg_tt6&_nc_cat=107&ccb=1-7&_nc_sid=833d8c&_nc_ohc=IrUOC-eK8vIQ7kNvwFMi8aZ&_nc_oc=AdpFvQFgXYdx2vxGoKYpp5uWzlLxCwTlyRqNQIo9AoW9kavRKYyfyrUUJIuDivMCg6bjXuBxaEhconmiPhDMB_pV&_nc_zt=23&_nc_ht=scontent.ftlv20-1.fna&_nc_gid=PiDkO_H1Ql3Kmm3UNme0uw&_nc_ss=7b2a8&oh=00_Af6SSmEYXvKQlcpeJYoQEg4ft7a0uMP-kj-fLclLbLWK7w&oe=6A165491\",\r\n\t\t\"https://scontent.ftlv20-2.fna.fbcdn.net/v/t39.30808-6/637673344_1449458980305322_2932579773881633366_n.jpg?stp=cp6_dst-jpg_tt6&_nc_cat=102&ccb=1-7&_nc_sid=833d8c&_nc_ohc=WhMA5gFSTUsQ7kNvwFLlFIO&_nc_oc=AdrrcNEiR16p5JsaPbp-b3BPJ2vKj_1qbMbMfZ5V5qRXUxW8oxqUwcRvqqBQnd6dFumns23N-5jDbXh0wGiN0wqi&_nc_zt=23&_nc_ht=scontent.ftlv20-2.fna&_nc_gid=faTV_rmGg6qKhl_xDfuJZg&_nc_ss=7b2a8&oh=00_Af4tC74dwSTsXFBRJjQv4_f-gj_bficuGUu66H5aip9HrQ&oe=6A165180\",\r\n\t\t\"https://cdn.jsdelivr.net/gh/bw3123/our-treasure@main/videos/rickMorty.mp4\",\r\n\t\t\"https://scontent.ftlv20-3.fna.fbcdn.net/v/t39.30808-6/637858395_1449459023638651_3638464709219369847_n.jpg?stp=cp6_dst-jpg_tt6&_nc_cat=105&ccb=1-7&_nc_sid=833d8c&_nc_ohc=MSl8VjFN9VYQ7kNvwHggZTY&_nc_oc=AdpDShpjqxq02snE_Po4iJyQHgSyFJe0VthevfOUyxGuKfvDH3Ptvc83xX78jUP-wMSep56Usebr4PbKvtHGkJ7J&_nc_zt=23&_nc_ht=scontent.ftlv20-3.fna&_nc_gid=RlrR9zBe18-fT6WESih4tg&_nc_ss=7b2a8&oh=00_Af7cED4ZJdle31Eyvh1BC6iYkY774McVgYOhUb7gLhSZ_A&oe=6A1632D3\",\r\n\t\t\"https://scontent.ftlv20-2.fna.fbcdn.net/v/t39.30808-6/639718115_1449459066971980_7946111619032921560_n.jpg?stp=cp6_dst-jpg_tt6&_nc_cat=101&ccb=1-7&_nc_sid=833d8c&_nc_ohc=lJStrO4Nf6QQ7kNvwGf4JP8&_nc_oc=AdqO3vsoFV8TEWRxYW2CIjgVMeqp3W9trUu8WZZsym01-EyKzERur5wY2dXmG_P2C9_SNBZkoMNKRSwmBMVR3JdR&_nc_zt=23&_nc_ht=scontent.ftlv20-2.fna&_nc_gid=hQLU9TW4ED1lBRFzm1WhVA&_nc_ss=7b2a8&oh=00_Af5rf8H-8n4ZaX4qAOWNO0qdvRWEVBBpATU6oucxuzSdLA&oe=6A164A87\",\r\n      ],\r\n      content: `● “Man can do what he wills, but he cannot will what he wills.”\r\n— Arthur Schopenhauer\r\nSchopenhauer argued that our desires are not freely chosen.\r\nWe experience them. We act on them.\r\nBut we do not author them.\r\nBehind romance, longing, and passion, he saw something impersonal:\r\nThe Will to Life — a blind force pushing organisms to reproduce.\r\nYou think you’re chasing happiness.\r\nNature is chasing continuation.\r\n● In The Selfish Gene, Richard Dawkins reframed evolution at the genetic level.\r\nGenes are the primary units of selection.\r\nOrganisms are vehicles.\r\n• Your body is temporary hardware.\r\n• Genes are long-term software.\r\nNatural selection keeps gene variants that increase replication probability.\r\nNot happiness. Not morality.\r\nReplication.\r\n● Over millions of years, gene variants survived if they produced brains that:\r\n• Release dopamine during attraction\r\n• Release oxytocin during bonding\r\n• Increase testosterone and estrogen for sexual motivation\r\n• Trigger jealousy to reduce mate competition\r\n• Cause distress when socially isolated\r\nThose emotional systems increased reproductive success, so they persisted.\r\nRomantic love feels transcendent.\r\nBiologically, it is a neurochemical reinforcement loop.\r\nEarly stage attraction:\r\nHigh dopamine. High norepinephrine. Low serotonin.\r\nObsession. Energy. Intrusive thinking.\r\nLong-term bonding:\r\nOxytocin dominance. Reward circuitry stabilization.\r\nThe intensity fades because long-term survival requires stability, not obsession.\r\nEvolution optimized for reproduction and offspring survival, not lifelong fireworks.\r\n● From the gene’s perspective:\r\n• You fall in love\r\n• You reproduce\r\n• You invest in offspring\r\n• You age\r\n• You die\r\nThe genes continue.\r\nThe organism is expendable.\r\nSchopenhauer suspected this philosophically.\r\nBiology replaced metaphysics with molecular detail.\r\n● Rick and Morty puts it bluntly:\r\n“Love is just a chemical reaction that compels animals to breed. It hits hard, then it slowly fades.”\r\nIt’s comedy.\r\nBut the biology tracks.\r\nIntensity initiates the cycle.\r\nBonding stabilizes it.\r\nReproduction completes it.\r\nDNA does not care about your story.\r\nIt cares about persistence.\r\n● But if genes are “selfish,” why do some people choose not to reproduce?\r\nBecause the selfish gene is a metaphor — not a dictator.\r\nGenes bias tendencies.\r\nThey do not enforce obedience.\r\nEvolution operates at the population level, not the individual level.\r\nNatural selection does not require every organism to reproduce.\r\nIt requires enough of them to.\r\nVariation is built into the system.\r\nSome individuals experience strong parental drive.\r\nOthers prioritize autonomy, abstraction, or long-term intellectual goals.\r\nThe same evolutionary process that built reproductive impulses also built self-reflection, contraception, philosophy, and long-term planning.\r\nA brain complex enough to understand evolution is complex enough to override parts of its own programming.\r\nOpting out of reproduction is not a defect.\r\nIt is a possible outcome of variation within the system.\r\nGenes do not plan, they persist statistically.\r\nAnd sometimes, the organism becomes aware of the game`\r\n    },\r\n\r\n\t{\r\n      title: \"\",\r\n      date: \"2026-02-17\",\r\n      photos: [\r\n        \"https://scontent.ftlv20-3.fna.fbcdn.net/v/t39.30808-6/634004957_1447244643860089_4188813901775030939_n.jpg?stp=cp6_dst-jpg_tt6&_nc_cat=108&ccb=1-7&_nc_sid=833d8c&_nc_ohc=odfk4mIcjyUQ7kNvwFfNZj-&_nc_oc=AdrxmHirYgTZmJWusj6ZKzSuQtE4ZVZqYxcKQ4y9mzWvfXksx3ONBhFrtr52DTczi5W8UtjlEBTPoIMZAtrkkTRX&_nc_zt=23&_nc_ht=scontent.ftlv20-3.fna&_nc_gid=8ThtTBZfRUZUkbEaPHa9iQ&_nc_ss=7b2a8&oh=00_Af6vXl5byrFUEQttB6Uhvaots4jr6Qg8B4xbL3RLLMGUYQ&oe=6A163625\",\r\n\t\t\"https://scontent.ftlv20-3.fna.fbcdn.net/v/t39.30808-6/634729761_1447244673860086_2690182008708935401_n.jpg?stp=cp6_dst-jpg_tt6&_nc_cat=103&ccb=1-7&_nc_sid=833d8c&_nc_ohc=qObkegvuAPAQ7kNvwGk86bU&_nc_oc=AdrGaRhLPm8urK_IWj_k1UVtskOpZK9pfCBUxvtCxEzvM56JlKbqvb3L_A5KV20JC_lXk2A0S-1ir8pKT06su1lo&_nc_zt=23&_nc_ht=scontent.ftlv20-3.fna&_nc_gid=rjGOeaWahxKtnKAKHAexPA&_nc_ss=7b2a8&oh=00_Af7qwmzfQBiufptZdT7taW-_ZaDNy_q3bX7aF19_pRH5Yw&oe=6A164BCA\",\r\n\t\t\"https://scontent.ftlv20-1.fna.fbcdn.net/v/t39.30808-6/636702202_1447244717193415_7309858042000323493_n.jpg?stp=cp6_dst-jpg_tt6&_nc_cat=107&ccb=1-7&_nc_sid=833d8c&_nc_ohc=46VoJmRJupQQ7kNvwFAVFZb&_nc_oc=AdoEFRAaxduiicqeESPHq4CLj_eVcF_pJUeUTlIBLLSot99jKwJt4VGk8SBPSE7luFJFZP8VO8Q6XDSYFAokInFM&_nc_zt=23&_nc_ht=scontent.ftlv20-1.fna&_nc_gid=Ru9GmR92X4F339keLdBc1w&_nc_ss=7b2a8&oh=00_Af6rixAdh7VsjnmCOJlWfuH-qzol4gxCPNEbFrN5t25XWg&oe=6A165F36\",\r\n\t\t\"https://scontent.ftlv20-1.fna.fbcdn.net/v/t39.30808-6/636702202_1447244717193415_7309858042000323493_n.jpg?stp=cp6_dst-jpg_tt6&_nc_cat=107&ccb=1-7&_nc_sid=833d8c&_nc_ohc=46VoJmRJupQQ7kNvwFAVFZb&_nc_oc=AdoEFRAaxduiicqeESPHq4CLj_eVcF_pJUeUTlIBLLSot99jKwJt4VGk8SBPSE7luFJFZP8VO8Q6XDSYFAokInFM&_nc_zt=23&_nc_ht=scontent.ftlv20-1.fna&_nc_gid=Ru9GmR92X4F339keLdBc1w&_nc_ss=7b2a8&oh=00_Af6rixAdh7VsjnmCOJlWfuH-qzol4gxCPNEbFrN5t25XWg&oe=6A165F36\",\r\n\t\t\"https://scontent.ftlv20-3.fna.fbcdn.net/v/t39.30808-6/636004108_1447244757193411_4932112631184195208_n.jpg?stp=cp6_dst-jpg_tt6&_nc_cat=108&ccb=1-7&_nc_sid=833d8c&_nc_ohc=p-jCnHcq5xgQ7kNvwHv7Uiz&_nc_oc=Adr-MUNpd2qL4WN95iehAtaXlPqJ5x45MdoeOE6GoIjci2pKTvem10Xz0Eh-fCVlQL2YbDLZ4mvO4SQ6ZLrKualI&_nc_zt=23&_nc_ht=scontent.ftlv20-3.fna&_nc_gid=DTcKzsk0kqb9xjjVDgd_hg&_nc_ss=7b2a8&oh=00_Af71bvE4Wfa_BU-aih0N0Qz18BIyg7T328rFG9u59TvM-Q&oe=6A1657C6\",\r\n\t\t\"https://scontent.ftlv20-3.fna.fbcdn.net/v/t39.30808-6/636859762_1447244793860074_4006619208319432657_n.jpg?stp=cp6_dst-jpg_tt6&_nc_cat=108&ccb=1-7&_nc_sid=833d8c&_nc_ohc=L4wbQc-YIZMQ7kNvwGxzqec&_nc_oc=AdpWQbgAexXzRB6bHRmxDl_jkV699k0HHctdM6jaBECUJ9vY0bRkcHyUFQ8CroHgqDJY1k0CfaT56-HOnyCKdbIe&_nc_zt=23&_nc_ht=scontent.ftlv20-3.fna&_nc_gid=HMoKBXuvG1x4IGOPjLLwYA&_nc_ss=7b2a8&oh=00_Af4CAy3w0toRw-8xH_w58Oam_DLpFjRuacyWvApKisOZtw&oe=6A166492\"\r\n      ],\r\n      content: `● Before Rome, before Athens, before most religious legal systems.\r\nThere was Babylon.\r\nOne of the earliest centralized empires in Mesopotamia, built between the Tigris and Euphrates rivers.\r\n● one of its most famous rulers was:\r\nKing Hammurabi \uD808\uDD29\uD808\uDD20\uD808\uDE2C\uD808\uDE8F\uD808\uDC49\r\nRuled around 1792–1750 BCE.\r\nHe expanded Babylon from a city-state into a regional empire and unified different populations under one standardized legal system.\r\nInstead of tribal revenge, he introduced centralized law.\r\nThat was revolutionary for its time.\r\n● How do we know?\r\nIn 1901, archaeologists discovered a 2.25 meter basalt stele in Susa (modern Iran).\r\nOn it:\r\nA relief of Hammurabi receiving authority from the god Shamash\r\n282 laws written in Akkadian cuneiform\r\nBecause cuneiform had already been deciphered in the 19th century, scholars translated it using thousands of other Mesopotamian tablets.\r\n● Some of his laws\r\n1) Trial by river\r\nIf accused without proof: Throw the accused into the river.\r\nIf they drown → guilty.\r\nIf they survive → innocent.\r\n2) Class based Justice\r\nThree main social categories:\r\nAwilu (elite)\r\nMushkenu (commoner)\r\nWardu (slave)\r\nSame crime = different punishment depending on status.\r\n3) Severe penalties\r\nThe death penalty applied in many cases, including helping a slave escape.\r\n● How he influenced cultural norms?\r\nHammurabi didn’t invent Middle Eastern culture.\r\nHe codified existing norms and made them state law.\r\nPatterns that appear in his code also appear later in:\r\n• Book of Exodus\r\n• Book of Leviticus\r\n• Book of Deuteronomy\r\nExamples include:\r\n• Retributive justice (“eye for an eye”)\r\n• Property compensation laws\r\n• Patriarchal inheritance structures\r\nHis model reinforced:\r\nHierarchy, Male guardianship, Honor-based logic.\r\nOver centuries, these structures merged with religion, empire governance, and later legal traditions.\r\nHe does not directly control modern society.\r\nBut he represents one of the earliest preserved foundations of regional legal logic.\r\n● Hero Then, problematic Now.\r\nBy our standards, many of his laws are unacceptable.\r\nBut history isn’t about judging the past emotionally.\r\nIt’s about understanding why systems worked in their timeline.\r\nHammurabi wasn’t a myth.\r\nHe was a ruler who carved law into stone.\r\nHe didn’t create morality.\r\nHe institutionalized power.\r\nAnd when power is written into law,\r\nit shapes civilizations for centuries.`\r\n    },\r\n\r\n\t{\r\n      title: \"\",\r\n      date: \"2026-02-15\",\r\n      photos: [\r\n        \"https://scontent.ftlv20-1.fna.fbcdn.net/v/t39.30808-6/633957816_1445568450694375_2512522694198968667_n.jpg?stp=cp6_dst-jpg_tt6&_nc_cat=107&ccb=1-7&_nc_sid=833d8c&_nc_ohc=qkX6s39dQWwQ7kNvwHt_BOa&_nc_oc=AdpeK3LK57NFW5n90A0NQx3dAur9qV-_QAQOHyRmSv5w8vSGMGEoHPBv7rpQ_KaXKAnYFBvODhhTSeLjvAAd6J7-&_nc_zt=23&_nc_ht=scontent.ftlv20-1.fna&_nc_gid=ozklekOJ3aw_GUQep0LcsQ&_nc_ss=7b2a8&oh=00_Af5vLRvrf_QmngtNOLV8K5DbB8cliN3HJ1_SlBRVHGxI0g&oe=6A164D72\",\r\n\t\t\"https://scontent.ftlv20-3.fna.fbcdn.net/v/t39.30808-6/636831678_1445568504027703_8164082720467031877_n.jpg?stp=cp6_dst-jpg_tt6&_nc_cat=105&ccb=1-7&_nc_sid=833d8c&_nc_ohc=R0oAtbXH6T8Q7kNvwFMLOeD&_nc_oc=AdrJ1JmkKAmQ8rrl_-HPSUVRD5100IeDQu3_OOLkCabD71KoKLNr-t82HjsTNBcDcZxbWH57vcfs3On9Kxdw3SLQ&_nc_zt=23&_nc_ht=scontent.ftlv20-3.fna&_nc_gid=n6zcXcMTmMp6g8ynYLFxzA&_nc_ss=7b2a8&oh=00_Af7_Z52iXMFxPQQco1uOReuBA0ZT9ZTIgpLE0QvRZg2w9g&oe=6A1650D8\",\r\n\t\t\"https://scontent.ftlv20-3.fna.fbcdn.net/v/t39.30808-6/634261320_1445568550694365_5283966830516589904_n.jpg?_nc_cat=105&ccb=1-7&_nc_sid=833d8c&_nc_ohc=fCoOMv0qrqEQ7kNvwE68nwP&_nc_oc=Adp_8GWxSCmzF0RKyQrabauEBw_hDjbJH6XjA-hpsY7WB6mjfEIFjFsflckYOOcVHzBxNLX490N_yvX5ajSWvz1k&_nc_zt=23&_nc_ht=scontent.ftlv20-3.fna&_nc_gid=u5a9YbSEjHPCXb0_r7j6Fw&_nc_ss=7b2a8&oh=00_Af5w9NEYoaYTy_NztnRP1mi0t8xh3m7m4oy0Bq98_-Up7w&oe=6A16634E\"\r\n      ],\r\n      content: `● Abu al-Ala al-Ma'arri was born in 973 CE in Ma’arrat al-Nu’man, Syria.\r\nHe lost his eyesight at the age of four.\r\nBut blindness never limited his intellectual vision.\r\nHe became one of the most brilliant poets and philosophers of the Islamic Golden Age.\r\nHe lived in extreme simplicity.\r\nHe refused luxury.\r\nHe refused power.\r\nHe refused conformity.\r\nHe even refused to consume animal products because he believed harming animals was immoral, an ethical stance centuries ahead of its time.\r\nHe described himself as “a prisoner of two prisons”: blindness and isolation.\r\nBut history knows him as something else:\r\nA free mind.\r\n● Al-Ma’arri questioned inherited beliefs.\r\nHe criticized blind imitation.\r\nHe placed reason above tradition.\r\nHe openly expressed skepticism toward organized religion and argued that many people follow beliefs because they inherit them, not because they examine them.\r\nIn the 10th–11th century, that was intellectual rebellion.\r\nSome called him a heretic.\r\nOthers called him dangerous.\r\nHe was neither, he was honest.\r\n● Despite his sharp criticism of society, Al-Ma’arri deeply admired Al-Mutanabbi, one of the greatest poets in Arabic history.\r\nWhen scholars attacked Al-Mutanabbi for his pride and boldness, Al-Ma’arri defended him.\r\nHe wrote detailed commentaries explaining the linguistic precision, rhetorical mastery, and philosophical depth of his poetry.\r\nThe man who questioned everything still recognized greatness.\r\nHe did not defend popularity.\r\nHe defended excellence.\r\n● In Risalat al-Ghufran, Al-Ma’arri imagined a journey through the afterlife, meeting poets in Heaven and Hell in a satirical, philosophical narrative.\r\nCenturies later, Dante Alighieri would write the Divine Comedy.\r\nMany scholars argue that Al-Ma’arri’s work may have influenced Dante’s vision.\r\nLong before Europe turned metaphysical journeys into epics, Al-Ma’arri had already done it.\r\n● Al-Ma’arri believed that life carries unavoidable suffering.\r\nBecause of this, he saw bringing children into the world as morally questionable.\r\nHe expressed this idea in one of the most powerful lines ever written in Arabic:\r\n“This is what my father committed against me, and I committed it against no one.”\r\n\"هذا ما جناه أبي عليّ وما جنيتُ على أحد\"\r\nIn one sentence, he summarized his worldview.\r\nExistence is imposed.\r\nSuffering is inherited.\r\nAnd he chose not to pass it on.\r\nHe never married.\r\nHe never had children.\r\nNot out of bitterness but out of principle.\r\n● Al-Ma’arri returned to his hometown and lived in intellectual isolation, refusing gifts from rulers and maintaining independence until his death in 1057 CE.\r\nThousands attended his funeral.\r\nEven those who disagreed with him respected his mind.\r\nAbu al-Ala al-Ma’arri was not ahead of his time.\r\nHe was beyond it.\r\nBlind, yet visionary.\r\nIsolated, yet universal.\r\nControversial, yet enduring.\r\nA thousand years later, his questions still unsettle comfortable minds.\r\nThat is not controversy.\r\nThat is legacy.`\r\n    },\r\n\r\n\t{\r\n      title: \"\",\r\n      date: \"2026-02-13\",\r\n      photos: [\r\n        \"https://scontent.ftlv20-2.fna.fbcdn.net/v/t39.30808-6/633951649_1443639570887263_3322388028688304568_n.jpg?_nc_cat=100&ccb=1-7&_nc_sid=833d8c&_nc_ohc=GZtsws-FoIwQ7kNvwFVPVDE&_nc_oc=AdoVMdIJhGGduVdwwclr94qC1712mXW_BbpjhCHG8q2kZokTnPbGfcr6R1RD7X5uc2o7-TiJyXIJ-PSCJk2hjevy&_nc_zt=23&_nc_ht=scontent.ftlv20-2.fna&_nc_gid=UftgArj9Ew7kubo0Gqbekw&_nc_ss=7b2a8&oh=00_Af7Nsj2hQVoVhwKRFNStUtnOJkPurBVi_bXaLPlIaGzSdA&oe=6A166217\",\r\n\t\t\"https://scontent.ftlv20-1.fna.fbcdn.net/v/t39.30808-6/633723251_1443639604220593_5774664966597379914_n.jpg?_nc_cat=107&ccb=1-7&_nc_sid=833d8c&_nc_ohc=9h5GOzF2CJgQ7kNvwHU9NmP&_nc_oc=AdoA8XA8a3itnvJwQlEPkBPHaT3nUvKBlQ_MIXIDfpUk5L5STc0CD9_DdqSJVZuTMzz_xhVressGp3yZa8AQROZG&_nc_zt=23&_nc_ht=scontent.ftlv20-1.fna&_nc_gid=zbVr2L0N0Ix3_EONmtuBzg&_nc_ss=7b2a8&oh=00_Af5uNFEeWglZDtefLUvwJEBSFtOoZCraVPi1_Ls5yuaJxw&oe=6A16430F\",\r\n\t\t\"https://scontent.ftlv20-2.fna.fbcdn.net/v/t39.30808-6/634003435_1443639630887257_8992111416541500696_n.jpg?_nc_cat=100&ccb=1-7&_nc_sid=833d8c&_nc_ohc=tsARVxiCKuIQ7kNvwGb6-Qy&_nc_oc=Ado5PBzHL7rdhqqWnoeAUEHWaahiaKSqLdViK8bQtCTeI8ODIMTGpArOagvTUKFHS9qdnp1HnQ2M_pVmn6vE4Eqr&_nc_zt=23&_nc_ht=scontent.ftlv20-2.fna&_nc_gid=uTlzPowu2eq2i3zCxvhuBQ&_nc_ss=7b2a8&oh=00_Af4Ql-EhVTBqlSuAW2jjQjeinrKmfUeAXoUSr9xbuMVw2A&oe=6A165834\",\r\n\t\t\"https://scontent.ftlv20-1.fna.fbcdn.net/v/t39.30808-6/633391658_1443639667553920_445477678501672234_n.jpg?_nc_cat=107&ccb=1-7&_nc_sid=833d8c&_nc_ohc=rxFeDkf2RX4Q7kNvwFVkQp9&_nc_oc=AdqCz9-rOJ0nfllvOhdo4jbQ1Ar_HqG6dLRivSswS-K3nYCkO5d9EhZyyCCm8iJ1mZ_9mZLIMg7vxZMbm_PjNeTh&_nc_zt=23&_nc_ht=scontent.ftlv20-1.fna&_nc_gid=10OcBUXtYZfyiiBB_jKpQg&_nc_ss=7b2a8&oh=00_Af5XBsUlo0iGhusJlP8gQKSCPBfsklLp-3eUHt0HE7MRvw&oe=6A16557D\",\r\n\t\t\"https://scontent.ftlv20-3.fna.fbcdn.net/v/t39.30808-6/632542058_1443639710887249_8967011349547695897_n.jpg?stp=cp6_dst-jpg_tt6&_nc_cat=105&ccb=1-7&_nc_sid=833d8c&_nc_ohc=qKIPI8oR2U4Q7kNvwFub_DU&_nc_oc=AdrWU1wd32eYyl_yNGSuSi9T7MT5wLmFuvwjUbsogRmwmnDxFxe7zpldFo4-RKnCmAGwl_nGLu8KgEET79usy8Nl&_nc_zt=23&_nc_ht=scontent.ftlv20-3.fna&_nc_gid=MwKNehkt6gOk2LxQ4D2Fow&_nc_ss=7b2a8&oh=00_Af4f9c_55MwzwnS6sNcovu40QrwDmqFY7eCB4_yF83DPag&oe=6A164A79\"\r\n      ],\r\n      content: `● Who Were the Neanderthals?\r\n And Why Do They Still Live Inside Us?\r\nNeanderthals (Homo neanderthalensis) lived in Europe and Western Asia from about 400,000 to 40,000 years ago.\r\nThey were not primitive “cavemen.”\r\nThey were human, just a different branch.\r\n● Were They Stronger Than Us?\r\nShort answer yes.\r\nNeanderthals were:\r\n• Shorter but extremely robust\r\n• Thick-boned and heavily muscled\r\n• Adapted to Ice Age cold\r\n• Likely stronger in upper-body power than early Homo sapiens\r\nThey hunted large animals at close range in brutal climates.\r\nPhysically, they were not inferior.\r\n● Did They Have Bigger Brains?\r\nYes, on average, Neanderthals had slightly larger cranial capacity than modern humans.\r\nHowever, brain size alone does not determine intelligence.\r\nWhat matters is brain organization, neural connectivity, and cognitive flexibility.\r\nNeanderthals:\r\n• Used complex tools\r\n• Controlled fire\r\n• Buried their dead\r\n• Cared for injured individuals\r\nThey were cognitively sophisticated.\r\nThere is no solid evidence that they were either smarter or less intelligent than Homo sapiens.\r\n● What Did They Eat?\r\nMostly:\r\n• Mammoths\r\n• Bison\r\n• Deer\r\nStable isotope studies show they were heavily meat based, sometimes even more carnivorous than early Homo sapiens.\r\nThey were Ice Age apex hunters.\r\n● Why Do We Have Their DNA?\r\n Because we met them.\r\nWhen Homo sapiens left Africa around 60–70 thousand years ago, we encountered Neanderthals in the Levant and Eurasia.\r\nAnd we interbred.\r\nToday, most non-African humans carry about 1–2% Neanderthal DNA.\r\nThat is genomic evidence of contact.\r\n● As David Reich explains in Them and Us\r\nHuman history is shaped by repeated population mixing.\r\nThere is no biological purity.\r\nAncient humans mixed with Neanderthals, and later populations mixed again and again across continents.\r\nOur species is the result of contact not isolation.\r\n● My Personal Result\r\nMy own data shows:\r\n• Less than 2% Neanderthal DNA\r\n• More Neanderthal variants than about 5% of users in that database\r\nThat doesn’t mean I’m “5% Neanderthal.”\r\nIt simply means I have slightly more Neanderthal DNA than some tested individuals in that database.\r\nI’m still overwhelmingly Homo sapiens.\r\n● What Did We Gain From Them?\r\n Some inherited Neanderthal variants helped early humans survive outside Africa:\r\n• Immune adaptations to Eurasian pathogens\r\n• Skin and hair traits suited for colder climates\r\n• Fat metabolism differences\r\n• Variations in pain sensitivity\r\nEvolution retained useful variants and removed incompatible ones.\r\nSelection is efficient.\r\n● Why Did They Disappear?\r\nThere is no single proven cause.\r\nHowever, the most widely supported hypothesis suggests that Homo sapiens’ larger social networks, higher population density, and greater cultural flexibility provided a long term advantage.\r\nOther contributing factors likely include:\r\n• Climate instability\r\n• Small Neanderthal population size\r\n• Inbreeding and genetic load\r\n• Partial absorption into Homo sapiens populations\r\nNatural selection does not simply reward strength.\r\nIt rewards adaptability in changing environments.`\r\n    },\r\n\r\n\t{\r\n      title: \"\",\r\n      date: \"2026-02-12\",\r\n      photos: [\r\n        \"https://scontent.ftlv20-1.fna.fbcdn.net/v/t39.30808-6/633517313_1442661017651785_5374880827036975741_n.jpg?stp=cp6_dst-jpg_s590x590_tt6&_nc_cat=107&ccb=1-7&_nc_sid=833d8c&_nc_ohc=9SJJ5vLoedsQ7kNvwGj9oAK&_nc_oc=Adqypt3Vthnbp9NQwPKZJp_ByR5SaugTaE1AfDqhFQzPnQSLgj0hMRyDgQV48mCIB3_UGUHLL_jbr3uhaHrY-NBn&_nc_zt=23&_nc_ht=scontent.ftlv20-1.fna&_nc_gid=x8sTvCIbqwn5swNC68zz4Q&_nc_ss=7b2a8&oh=00_Af4MZ3SfSDTpNH2jBlx2u9U_dYhXUE3PJzdSAOxVuIWDng&oe=6A153FF3\",\r\n\t\t\"https://scontent.ftlv20-2.fna.fbcdn.net/v/t39.30808-6/633776484_1442661060985114_508234198740240756_n.jpg?stp=cp6_dst-jpg_tt6&_nc_cat=101&ccb=1-7&_nc_sid=833d8c&_nc_ohc=_ShWYznjOyUQ7kNvwGaBqBg&_nc_oc=AdqPy9ZkRL7-5zwQXoLxoVEMrRITwHyst0meixLot8erhmbS4OSpRbg0ciJr5bsaybStFiBpSV5ov-OwVWMJF5V3&_nc_zt=23&_nc_ht=scontent.ftlv20-2.fna&_nc_gid=EAS1ZBmDfgJVLh09X9J1GQ&_nc_ss=7b2a8&oh=00_Af5BniJQ7Wv-T-syN2eQ5xVjul4JntLIHSIdBLrt_gSl_Q&oe=6A164006\",\r\n\t\t\"https://scontent.ftlv20-3.fna.fbcdn.net/v/t39.30808-6/633409862_1442661104318443_609572429480855724_n.jpg?stp=cp6_dst-jpg_tt6&_nc_cat=109&ccb=1-7&_nc_sid=833d8c&_nc_ohc=MenU_M2HkUkQ7kNvwHhetwu&_nc_oc=AdoSMHa9DPHQMsHIMl0tldtvwRULNMWIhorafmoFFTxluSSN8n4ebunXB7n9CfNkgn6OU_NPSDLpKKcr33vWVvgW&_nc_zt=23&_nc_ht=scontent.ftlv20-3.fna&_nc_gid=URitcXnvawD4QD11QirbsQ&_nc_ss=7b2a8&oh=00_Af4AWe7pm5Pp7SyWGwNezmLgkUZLspUqgP_z0PjyOVMMUA&oe=6A166CB6\",\r\n\t\t\"https://scontent.ftlv20-1.fna.fbcdn.net/v/t39.30808-6/630903638_1442661180985102_1615429845461689845_n.jpg?_nc_cat=110&ccb=1-7&_nc_sid=833d8c&_nc_ohc=ZUERxotHq6QQ7kNvwE8wjrJ&_nc_oc=AdoHVbnD_4Es_vrbnZ5NPfu24ui7niuXPdystl5jurFIjlfLga8Da4NNhSfJcZQaP5bFcCC3faT8Eiwb6gZmuZLK&_nc_zt=23&_nc_ht=scontent.ftlv20-1.fna&_nc_gid=HmemoFe8f54yObWeDQkfRw&_nc_ss=7b2a8&oh=00_Af6KqhUwfWA02cyeLgRJcIrsyY8TPGhW3-dgSgN_vtNCEA&oe=6A166745\",\r\n\t\t\"https://scontent.ftlv20-2.fna.fbcdn.net/v/t39.30808-6/634360265_1442661230985097_2067381098377169539_n.jpg?stp=cp6_dst-jpg_tt6&_nc_cat=101&ccb=1-7&_nc_sid=833d8c&_nc_ohc=w1-Sg6AP1NoQ7kNvwH4Lo_3&_nc_oc=AdoBIfQ_RuEjSGZdXZ326VeNA-MDOaeVTRKVRSSNs-1YBB9KNeeEpjF8SN7ZL_wn7Ywb6m7SFaMA3LbWQUEYCEr5&_nc_zt=23&_nc_ht=scontent.ftlv20-2.fna&_nc_gid=5nwmwU00B87k7eju7anJPA&_nc_ss=7b2a8&oh=00_Af4ukMtrFXjdvFW7jwE33Zpi4PA77WT8vetZMLhTlr1cSA&oe=6A164EF9\"\r\n      ],\r\n      content: `● “Free will is an illusion.”\r\n— Sam Harris\r\nWe heard this quote before but is it?\r\nbiology forces us to at least examine it seriously.\r\n● Modern behavioral genetics shows that personality traits are partially heritable. Large twin studies estimate:\r\n• Empathy: roughly 30–50% heritable\r\n• Neuroticism: ~40–50%\r\n• Agreeableness: ~40%\r\n• Stress reactivity: significantly influenced by genetic variation\r\n● This does not mean DNA determines behavior with certainty.\r\nIt means it shapes baseline tendencies.\r\nSpecific gene variants have been statistically associated with social and emotional traits:\r\n• OXTR (oxytocin receptor gene) → social bonding and empathy\r\n• SLC6A4 (serotonin transporter variants) → emotional reactivity\r\n• DRD4 → novelty seeking\r\n• MAOA variants → impulse regulation under certain environmental conditions\r\nSo part of what we call “personality” is biologically scaffolded.\r\n● Then there is generational trauma.\r\nWhat people call “ancestral trauma” is better understood through epigenetics.\r\nEpigenetics refers to biochemical modifications (such as DNA methylation or histone modification) that alter gene expression without changing the DNA sequence itself.\r\nSevere stress exposure has been shown, in both animal models and some human populations, to produce epigenetic changes in genes related to stress regulation, including glucocorticoid receptor pathways.\r\n○ Research involving descendants of Holocaust survivors and individuals exposed to the Dutch Hunger Winter suggests that stress-related epigenetic markers may, in some cases, persist across generations.\r\nThis does not mean we inherit memories.\r\nIt suggests we may inherit altered stress-response sensitivity.\r\nIn other words, even our stress thresholds may be partially shaped before we are born.\r\n● How can scientists “read” these tendencies?\r\nDNA testing platforms analyze SNPs (single nucleotide polymorphisms) and compare them to large genome-wide association studies (GWAS). If certain variants are statistically associated with a trait across large populations, a probabilistic predisposition score is calculated.\r\nIt is not prediction of destiny.\r\nIt is statistical likelihood.\r\nFor example, some of my own DNA-based trait results include:\r\n• Empathy- high tendency\r\n• Open minded- high tendency\r\n• Gratitude- high tendency\r\n• Conscientiousness- high tendency\r\nThese results do not mean “this is who I must be.”\r\n○ They reflect genetic variants associated with differences in oxytocin signaling, serotonin transport, dopaminergic regulation, impulse control pathways, and attentional modulation networks.\r\n● None of these are moral verdicts.\r\nThey are neurobiological tendencies.\r\nNeuroscience further shows structural and functional variability in empathy related circuits, including the amygdala, anterior insula, and medial prefrontal cortex. Some individuals are measurably more reactive to others’ suffering at the neural level.\r\nIf:\r\nWe do not choose our genes,\r\nWe do not choose our baseline neurochemistry,\r\nWe may inherit stress-response modulation,\r\nAnd our emotional circuitry varies biologically\r\nThen how much of who we are is chosen?\r\nFree will may not mean choosing our traits.\r\nIt may mean regulating tendencies within biological constraints.\r\nThe question is not whether biology influences us.\r\nIt clearly does.\r\nThe real philosophical question is:\r\nIs constrained regulation enough to call it freedom?`\r\n    },\r\n\r\n\t{\r\n      title: \"\",\r\n      date: \"2026-01-31\",\r\n      photos: [\r\n\t  \"https://scontent.ftlv20-2.fna.fbcdn.net/v/t39.30808-6/625076261_1432715805312973_8684827414505144918_n.jpg?stp=cp6_dst-jpg_tt6&_nc_cat=100&ccb=1-7&_nc_sid=833d8c&_nc_ohc=gIWzRIAmkFEQ7kNvwFNpgaN&_nc_oc=AdoUlYHAsvWsFZDV9P22FXjnjy7I-FgQ3wKAd4F0ftftEtoYTJPZDKO4B4YuMqeh0gPumBRsGvbGbJ-S_6iwdLlp&_nc_zt=23&_nc_ht=scontent.ftlv20-2.fna&_nc_gid=YgKF73ByqFlHMcg7LKUHqA&_nc_ss=7b2a8&oh=00_Af4oBh60ZR_NnT08wGRXbr6AAOtzvsqFRNvA9Qw-S5GjHg&oe=6A165D38\",\r\n\t  \"https://scontent.ftlv20-1.fna.fbcdn.net/v/t39.30808-6/623418499_1432715848646302_1326139515287797493_n.jpg?stp=cp6_dst-jpg_tt6&_nc_cat=106&ccb=1-7&_nc_sid=833d8c&_nc_ohc=Y66L6Iq6LRMQ7kNvwGpzqHG&_nc_oc=AdoulhNMyPEg38BwOGK0FAAWwhHrltbmQMbGEmT23zfGQtdMELNr0GKFqtyRhq1rE6uuwu86HP0Du8fX8kYlHq0g&_nc_zt=23&_nc_ht=scontent.ftlv20-1.fna&_nc_gid=h8d4tDWtcc2kA10ZxQWBOw&_nc_ss=7b2a8&oh=00_Af6qG-qPp9UaktPAYu-A9DcHnni7HP4TYwqnQKmZVDpaPw&oe=6A163BB5\",\r\n\t  \"https://scontent.ftlv20-1.fna.fbcdn.net/v/t39.30808-6/624543565_1432715885312965_9206411966747950714_n.jpg?stp=cp6_dst-jpg_tt6&_nc_cat=111&ccb=1-7&_nc_sid=833d8c&_nc_ohc=31DOrumasFEQ7kNvwF0vQnm&_nc_oc=AdqfDtpne2Y6NHkY67MBYjn2sFVTQo3HO9b2oQBNMSYRSrnOfNBfFmpyLcwbj3T12ae6xMUci5c3Z61qQe3zbqre&_nc_zt=23&_nc_ht=scontent.ftlv20-1.fna&_nc_gid=Pf66-IANOIJwpRmRWfP8vA&_nc_ss=7b2a8&oh=00_Af7cG9N2E6SpxMqkSups4WSe1MnGU9ZgaI1hNHG1scIdDA&oe=6A164757\",\r\n\t  \"https://scontent.ftlv20-3.fna.fbcdn.net/v/t39.30808-6/623867601_1432715918646295_2724515636610455769_n.jpg?stp=cp6_dst-jpg_tt6&_nc_cat=108&ccb=1-7&_nc_sid=833d8c&_nc_ohc=MT5D23UpvHgQ7kNvwGfB2q4&_nc_oc=Adppsg7qL7hYUeFcdHAnjsxqJPAHZRxccxzbgTCiMZGcWfuYDaZfazl-v35NWCJ5gDz8TsVWniDG2MW_rx8wQPWI&_nc_zt=23&_nc_ht=scontent.ftlv20-3.fna&_nc_gid=M-M5Ry9uuAGG_7PmLQHIkA&_nc_ss=7b2a8&oh=00_Af6azwxeWXH7mBSZ3HPuyTIFbrLaNe469K_35y-hTg1neA&oe=6A165652\",\r\n\t  \"https://scontent.ftlv20-3.fna.fbcdn.net/v/t39.30808-6/623688721_1432715961979624_3802573185386293386_n.jpg?_nc_cat=103&ccb=1-7&_nc_sid=833d8c&_nc_ohc=uq6Won2gONcQ7kNvwGUpX1F&_nc_oc=AdrYspd1O26IOOWhn7F9SneQLMzmWC7tPApqxdJX7rwe_znbJlddM2b4UHTXBBqPR8xqFkt5l9GVuVURYaX-ccn6&_nc_zt=23&_nc_ht=scontent.ftlv20-3.fna&_nc_gid=JY9d8vXvoJ3UuE5bC1aV7A&_nc_ss=7b2a8&oh=00_Af5tglR00Rj-gwqWGF8uSvD24byXAXA12yOsKhCr1xyDJw&oe=6A163E6E\"\r\n\t],\r\n      content: `● People think morality is about right and wrong.\r\nScience shows it’s mostly about how things make us feel.\r\nHuman moral judgment is not neutral or objective.\r\nIt is driven by fast, automatic emotional systems shaped by evolution.\r\nEmpathy is selectively triggered.\r\nFeatures like large eyes, softness, symmetry, and fragility activate caregiving circuits in the brain.\r\nThat’s why killing a butterfly feels morally wrong\r\nwhile killing a cockroach feels acceptable.\r\nSame action.\r\nSame outcome.\r\nDifferent moral reaction.\r\nThat difference has nothing to do with ethics.\r\nIt’s aesthetic bias.\r\n● At the center of this process is the amygdala.\r\nA pair of almond shaped nuclei buried deep in the medial temporal lobe.\r\nIts role is rapid threat detection and emotional salience.\r\nit decides what matters and what is dangerous before conscious thought.\r\nThis same mechanism explains why killing a snake often feels justified.\r\nSnakes strongly activate the amygdala, triggering an immediate fear response that occurs before reasoning.\r\nEven infants and primates with no prior learning show heightened attention and fear toward snake like shapes.\r\nSnakes lack neotenous features.\r\nNo big eyes.\r\nNo fur.\r\nNo facial expressions that trigger empathy.\r\nSo the brain reframes killing as prevention rather than violence.\r\nThe animal is no longer a living organism acting according to its biology\r\nbut a symbol of danger.\r\nThis is pre-moral judgment.\r\nReason comes later to justify the feeling.\r\n● These shortcuts don’t stop at animals.\r\nThey scale directly to humans.\r\nIn-group and out-group bias follow the same neural rules.\r\nWho looks familiar.\r\nWho feels safe.\r\nWho fits the dominant narrative.\r\nViolence is condemned or excused not by what is done\r\nbut by who does it and who receives it.\r\n● Friedrich Nietzsche identified this long before neuroscience caught up.\r\nIn Beyond Good and Evil, he rejects the idea of universal morality.\r\nGood and evil are not discovered truths.\r\nThey are human constructions shaped by instinct, power, fear, and social utility.\r\nMorality, for Nietzsche, is a language groups use to preserve themselves.\r\nWhat is called “good” protects the dominant order.\r\nWhat is called “evil” threatens it.\r\nSo when we decide who is a hero and who is a monster\r\nwe are rarely making a moral judgment.\r\nWe are making a psychological and political one.\r\nWho can be harmed without discomfort.\r\nWho can be dehumanized without guilt.\r\nJustice isn’t blind.\r\nEmpathy is rationed.\r\n● This framework is illustrated in popular culture by Garou, a character who rejects both “justice” and “evil” and exposes how societies manufacture monsters through selective morality rather than universal ethics.\r\n\"Good, evil I reject them both.”`\r\n    },\r\n\r\n\t{\r\n      title: \"\",\r\n      date: \"2026-01-29\",\r\n      photos: [\r\n\t  \"https://scontent.ftlv20-1.fna.fbcdn.net/v/t39.30808-6/623366787_1430727495511804_6078028088306915671_n.jpg?stp=cp6_dst-jpg_s590x590_tt6&_nc_cat=110&ccb=1-7&_nc_sid=833d8c&_nc_ohc=88OrFSj9bMoQ7kNvwEPskP4&_nc_oc=AdqiAfDGW6po2a8Ig-juVftNvJcHAYxTCS8RE7HbNfZ_zJQHmNuvtrKykd8twLOyruMv4EUBDZzN3iYawfwubFIl&_nc_zt=23&_nc_ht=scontent.ftlv20-1.fna&_nc_gid=x8sTvCIbqwn5swNC68zz4Q&_nc_ss=7b2a8&oh=00_Af6XGh5auMStdQ3pHdlgERv4W6ZOLxtRXgxGue8p9fx4jQ&oe=6A155053\",\r\n\t  \"https://scontent.ftlv20-3.fna.fbcdn.net/v/t39.30808-6/622354559_1430727538845133_1887765862963248826_n.jpg?_nc_cat=105&ccb=1-7&_nc_sid=833d8c&_nc_ohc=OLiVgbN0i6cQ7kNvwFqn03A&_nc_oc=AdrWPppKeZb-Z0i_6NTPjly9zyRIj4JOrr266ob76mr9F9w3F8AXq2oHA30KyL13CgV22OjQa8cnGbvavHpyYtVi&_nc_zt=23&_nc_ht=scontent.ftlv20-3.fna&_nc_gid=OxBO3BB0Z_8RjEPXr9ut3w&_nc_ss=7b2a8&oh=00_Af7W5YtM3TheMniejyim0XKgLqRBnVK69zvrkIczNMnikw&oe=6A1653FB\",\r\n\t  \"https://scontent.ftlv20-2.fna.fbcdn.net/v/t39.30808-6/622832235_1430727585511795_5795901868018353697_n.jpg?_nc_cat=101&ccb=1-7&_nc_sid=833d8c&_nc_ohc=OkGx0LdPBEcQ7kNvwEnapok&_nc_oc=AdoewNQ3a1F_xQrrGMjSmrO_6DAFPGZrUE4l3u81h57y_LKjMXbx1JuqiZ5zFedZkcIt0Ufst26NU0m1VJ0QTphD&_nc_zt=23&_nc_ht=scontent.ftlv20-2.fna&_nc_gid=eArZLJ5_6lMtQKVGamhWew&_nc_ss=7b2a8&oh=00_Af7wWMGjq8tTlN4Fzf5IXrUM4tvtyLa14GoR92CHrHPrCg&oe=6A165906\"\r\n\t],\r\n      content: `● Achondroplasia is the most common form of dwarfism and is a genetic disorder caused by a mutation in the FGFR3 (Fibroblast Growth Factor Receptor 3) gene.\r\n○ FGFR3 plays a key role in regulating endochondral ossification, the process by which cartilage is converted into bone during fetal development and childhood.\r\nUnder normal conditions, FGFR3 acts as a growth regulator, it prevents bones from growing too fast or too long.\r\n• In achondroplasia, a specific mutation makes the FGFR3 receptor overactive.\r\nThis means the “stop signal” for bone growth is stronger than usual.\r\nAs a result:\r\ncartilage cells (chondrocytes) divide and mature more slowly\r\nlong bone growth is reduced\r\nlimb length is shortened relative to the torso\r\nThis primarily affects:\r\n1) arms and legs\r\n2) hands and fingers\r\n3) certain parts of the skull base\r\n4) Flat bones (such as those of the skull)\r\n○ Achondroplasia does not affect cognitive abilities.\r\nIntelligence, learning capacity, emotional development, and personality are completely normal.\r\nThe nervous system develops typically.\r\nAny challenges are structural and physical, not neurological or intellectual.\r\n○ Achondroplasia is inherited in an autosomal dominant manner.\r\nAbout 80% of cases occur spontaneously, meaning neither parent has the condition\r\nAbout 20% are inherited from a parent with achondroplasia\r\nThe condition occurs in approximately 1 in 15,000–25,000 live births worldwide.\r\nThis mutation is stable and well characterized it is not random chaos.\r\nIt is a known biological pathway behaving differently.\r\n○ Common physical characteristics include:\r\nshortened limbs with normal torso length\r\ncharacteristic skeletal proportions\r\ndifferences in spinal curvature\r\ndistinct facial bone development\r\nSome individuals may experience medical complications such as:\r\n1) spinal canal narrowing\r\n2) joint stress\r\n3) ear infections\r\n4) breathing or sleep related issues\r\nThese are manageable medical considerations, not defining features of identity.\r\n○ Modern medical research does not aim to “fix” the genetic mutation itself.\r\nInstead, some therapies focus on:\r\nmodifying FGFR3 signaling\r\ninfluencing growth plate activity\r\nsupporting limb growth through targeted molecular approaches\r\nThis includes research into customized growth hormone related and pathway specific therapies, designed to reduce certain physical challenges not to change who a person is.\r\n● I wrote all this because of a unique kid named Waed who has Achondroplasia\r\n● To my dear Waed\r\nIf you’re old enough to read this now, I want you to know something clearly.\r\nYou are a gifted child.\r\nYes, you carry challenges but they shaped strength, not limitation.\r\nYou don’t owe anyone explanations.\r\nNot for your body.\r\nNot for who you are.\r\nYou are beautiful.\r\nAnd your personality is even more stunning.\r\nI never thought I liked kids.\r\nBut you are the one who changed that.\r\nThe first time I held you, I felt something I didn’t expect unconditional love.\r\nEven though you’re not my own, I’m your aunt, and I didn’t want to let you go.\r\nYou matter.\r\nYou deserve the best.\r\nBelieve in yourself.\r\nAnd always know this:\r\nyour aunt is here.\r\nAlways supporting you.\r\nAlways loving you.\r\n\uD83E\uDD0D`\r\n    },\r\n\r\n\t{\r\n      title: \"\",\r\n      date: \"2026-01-28\",\r\n      photos: [\r\n\t  \"https://scontent.ftlv20-2.fna.fbcdn.net/v/t39.30808-6/622372819_1430061928911694_7144097191142720109_n.jpg?_nc_cat=104&ccb=1-7&_nc_sid=833d8c&_nc_ohc=Ixp5cJYdmiYQ7kNvwGnVcMb&_nc_oc=AdrGUID-K8DsFsC1fmWal73gKwhtuNzpuNXZqmSQehTfKw6N1YrxBYAOQkEfraF4hZR0QWaUeEzcGkvLzH7l9oeU&_nc_zt=23&_nc_ht=scontent.ftlv20-2.fna&_nc_gid=luf-n-hnNCLkdBMvaomeZg&_nc_ss=7b2a8&oh=00_Af5XXYIU_P4nvoE3Oc9oCuaoaORtWYFv5c5IiF_0BWul4Q&oe=6A1658AE\",\r\n\t  \"https://scontent.ftlv20-1.fna.fbcdn.net/v/t39.30808-6/620029742_1430061965578357_290077111404656735_n.jpg?stp=cp6_dst-jpg_tt6&_nc_cat=107&ccb=1-7&_nc_sid=833d8c&_nc_ohc=pRQo9hYvPyIQ7kNvwGArbi4&_nc_oc=AdqdfCKvTO4dWThCxtibqRlAI_JPz1ZExUpDXdBLHvmWXSy6ImY2htjQdC9QypwN4PkdEAKS5vSSLKUoF0TerXD7&_nc_zt=23&_nc_ht=scontent.ftlv20-1.fna&_nc_gid=lmWDR_w-Pc4wlW48cKMRBw&_nc_ss=7b2a8&oh=00_Af4gH7AVUAMmYV9foi2YAuw6BC-ChHLus__q8tqHdKR61A&oe=6A166BF7\",\r\n\t  \"https://scontent.ftlv20-3.fna.fbcdn.net/v/t39.30808-6/619509583_1430062005578353_854053424816547939_n.jpg?stp=cp6_dst-jpg_tt6&_nc_cat=103&ccb=1-7&_nc_sid=833d8c&_nc_ohc=ZcAchiGImt0Q7kNvwHK9gOF&_nc_oc=AdpATMo7a0wSmAwILjuliYBT66VHsOG9mReH-8R9W0iKFt311n65lSXyZOkBJfCQxWKua0Mj6KaZa6mSsbWgdKh8&_nc_zt=23&_nc_ht=scontent.ftlv20-3.fna&_nc_gid=gQTZd7aIhlefAIxpAY_2mg&_nc_ss=7b2a8&oh=00_Af7iBlVgH4vSh9fo1FfmkB39ABvFeIDmPLB91Z5osVRYtQ&oe=6A166231\",\r\n\t  \"https://scontent.ftlv20-3.fna.fbcdn.net/v/t39.30808-6/623392411_1430062045578349_7067162944281550699_n.jpg?stp=cp6_dst-jpg_tt6&_nc_cat=103&ccb=1-7&_nc_sid=833d8c&_nc_ohc=6tI7W9iqHLoQ7kNvwHd2Q1n&_nc_oc=Adr1xiQTCwlK2kvh5U9jNIIaBv1rA9XTjIarLdSVvV0EJMQ3LlRo9jsC_QRVn1jj-MhhqNj2RNZXwOYzCfLE87g6&_nc_zt=23&_nc_ht=scontent.ftlv20-3.fna&_nc_gid=Jt6KfIiDNXL5mx5TzRMThg&_nc_ss=7b2a8&oh=00_Af74dIDzOZNiiEBIlXwXttZ3XQ4jVEHkIHmRHsfAS4yk8g&oe=6A163F1F\"\r\n\t],\r\n      content: `● As one of my favorite philosophers Friedrich Nietzsche said:\r\n\"Madness is rare in individuals, but in groups, parties, nations, and ages it is the rule.\"\r\n●Trends are modern commandments.\r\nNot argued, Not questioned, Repeated until they feel inevitable for example:\r\nA doll.\r\nA chocolate.\r\nA face.\r\n● Let’s talk about the face:\r\n○ Fillers: what they actually are\r\nMost cosmetic fillers are hyaluronic acid.\r\nA molecule your body naturally produces.\r\nThat’s why people feel safe.\r\nBiology doesn’t care about familiarity or marketing.\r\n• Hyaluronic acid fillers work by binding water and expanding tissue.\r\nThey create volume by swelling, not by rebuilding structure.\r\nThat volume is not bone, Not muscle.\r\n• Over time fillers can migrate they can accumulate they can persist far longer than promised\r\nMRI studies have shown filler material years after it was supposed to dissolve, faces don’t age symmetrically.\r\nWhat they don't know is that gravity always wins and biology adapts around interference.\r\nThat’s how “temporary” becomes permanent maintenance.\r\n○ Botox: it blocks neuromuscular transmission.\r\nNo signal → no contraction → fewer wrinkles.\r\n• In medicine, it’s a powerful tool its used for treating migraines, spasticity ,neurological disorders.\r\n• In cosmetics, it’s sold as control over time but what are the long term side effects?\r\n1) Muscles that don’t move atrophy.\r\n2) Blood flow decreases.\r\n3) Lymphatic drainage slows.\r\n4) Other muscles compensate.\r\n5) Facial balance shifts.\r\n6) Expression flattens.\r\n•Your face is not decoration. It’s part of your nervous system.\r\nYou’re not stopping aging.You’re redirecting it.\r\n● Now the real issue: social pressure\r\nWhat’s new isn’t injections.\r\nWhat’s new is how aggressively non-participation is punished.\r\nIf you don’t inject\r\nyou’re told you’re “letting yourself go”\r\n“not taking care of yourself”\r\n“falling behind”\r\n○ As Plato warned:\r\nThe greatest deception is believing the many are wiser than the few.\r\nSome people fall in line.\r\nSome resist.\r\nResistance is never called a choice.\r\nIt’s called ignorance.\r\n● In conclusion:\r\nAging isn’t the enemy.\r\nThinking less because others are thinking less is.\r\nBiology keeps records.\r\nSocial trends don’t erase consequences.\r\nJust because everyone is walking the same path\r\ndoesn’t mean it leads somewhere safe.`\r\n    },\r\n\r\n\t{\r\n      title: \"\",\r\n      date: \"2026-01-17\",\r\n      photos: [\r\n\t  \"https://scontent.ftlv20-3.fna.fbcdn.net/v/t39.30808-6/617688041_1420920749825812_2764981588927500391_n.jpg?_nc_cat=105&ccb=1-7&_nc_sid=833d8c&_nc_ohc=KLzlsFZ2lQQQ7kNvwEZZRAa&_nc_oc=Adq137sn4aFASSM4bBqxmdaV2xo1vMoPwpLUTWsx-q0rhekxT23M1p9ygvO97JaPPe9YrswsRtTMGJ77tkCDv1Oe&_nc_zt=23&_nc_ht=scontent.ftlv20-3.fna&_nc_gid=ThrbdVywUataPYYfVv6M1Q&_nc_ss=7b2a8&oh=00_Af5CR8g8es4IpWCEoEqIyqH2JPldr0P1a6vvkfGlmsdwRg&oe=6A163DCC\",\r\n\t  \"https://scontent.ftlv20-3.fna.fbcdn.net/v/t39.30808-6/615909258_1420920793159141_8931397000854655362_n.jpg?_nc_cat=105&ccb=1-7&_nc_sid=833d8c&_nc_ohc=nW-OgaFNSeQQ7kNvwFshY9h&_nc_oc=AdpslXFTVM3KI8jCyBeyFqqiCgGQAeNTZJcxO_vk3B0rw1FLT1iAOld0wb0pwLJqC7GG-wqXJgrMlFS8nuqw0AQz&_nc_zt=23&_nc_ht=scontent.ftlv20-3.fna&_nc_gid=vt119-9g6nk5oA-pA4l2gg&_nc_ss=7b2a8&oh=00_Af6rfN-N6cMxpF-uSLOoSx4voxHNU0oh2ImGY-rIV1wqyA&oe=6A166C3F\",\r\n\t  \"https://scontent.ftlv20-1.fna.fbcdn.net/v/t39.30808-6/616147246_1420920829825804_2250554935949039284_n.jpg?_nc_cat=111&ccb=1-7&_nc_sid=833d8c&_nc_ohc=TXhO6c_-7HUQ7kNvwHec6F_&_nc_oc=Adrs2tQaYph6aS8nBaqc3GgHg_xVxpLqp9kGKYGXoHB2yaoCOoS_MI98Ekc0kETdnU05GSm-e3zDp-SPeAY0HK1b&_nc_zt=23&_nc_ht=scontent.ftlv20-1.fna&_nc_gid=4uGpI-DmIfKeJwojGDI6zA&_nc_ss=7b2a8&oh=00_Af7fCPbGC2ue4jh5-8SvJ9grymcjtxmn1tOSGq7iW4cLfg&oe=6A165A6A\"\r\n\t],\r\n      content: `● Plato warned that democracy fails when numbers outweigh knowledge.\r\nNot every opinion carries the same weight, because not every opinion is formed through understanding. When the majority decides without reflection, wisdom gets outvoted and thinkers get pushed aside.\r\nThat wasn’t elitism. It was psychology.\r\n● Now let’s look at ants.\r\nAnt colonies function through pheromone trails. One ant passes and leaves a signal. Others follow. The more ants that follow a path, the stronger the signal becomes. This positive feedback helps coordination, but it has a flaw: early random paths can become locked in, even if they’re inefficient or wrong. Once reinforced, the colony keeps following the same trail.\r\nAnts aren’t irrational. They’re optimized for speed, not truth.\r\n● Humans run on the same logic, just with ideas instead of chemicals.\r\nFrom an evolutionary perspective, following the group was adaptive. Our ancestors survived by staying inside the herd. Copying the majority reduced risk, saved energy, and avoided social punishment. This is known in evolutionary biology as conformist transmission: when individuals adopt the most common behavior simply because it is common.\r\nAdd authority bias to the mix, and obedience increases even more. When a belief is repeated by leaders, institutions, or religious figures, the brain labels it as safe, regardless of whether it’s true.\r\n● Critical thinking, on the other hand, is rare because it is costly. It is slow, effortful, and socially risky. Most environments reward conformity, not reflection. So the system selects for compliance, not depth.\r\n● this is where it drives our societies.\r\nWe end up with people defending ideas they privately doubt, abandoning values they once held, and following rulers or religious personas simply because the signal is strong. Beliefs become reinforced by repetition, not by evidence. Popularity replaces understanding.\r\nAt that point, society stops thinking and starts echoing.\r\n● Ants follow chemical trails because they have no alternative.\r\nHumans follow mental trails because it feels safer.\r\nThe difference is that humans can stop, question, and choose.\r\nIf an idea collapses under questioning, it was never strong, It was just popular.`\r\n    },\r\n\r\n\t{\r\n      title: \"\",\r\n      date: \"2025-12-19\",\r\n      photos: [\r\n\t  \"https://scontent.ftlv20-1.fna.fbcdn.net/v/t39.30808-6/600348358_1399334181984469_474760281138986600_n.jpg?_nc_cat=107&ccb=1-7&_nc_sid=833d8c&_nc_ohc=xc4L5jxx1F4Q7kNvwFh_hqR&_nc_oc=AdrKcGnhB3QHDjphB7xpR_uOmAm1n_6hN_0fJEfN__oz_rjcN28mfLgEGK1M-L4E1cPydtUlLslnGlh5KH3D8PkI&_nc_zt=23&_nc_ht=scontent.ftlv20-1.fna&_nc_gid=6haB-aTvTNV2c_GaasEe8w&_nc_ss=7b2a8&oh=00_Af47EEFkQmcB6M7bC55XTpZmYZuTPZ_DSHqVwP58Pt_BFA&oe=6A163DFD\",\r\n\t  \"https://scontent.ftlv20-2.fna.fbcdn.net/v/t39.30808-6/600137147_1399334225317798_4811199198619597332_n.jpg?_nc_cat=102&ccb=1-7&_nc_sid=833d8c&_nc_ohc=ME5ckxh8iRoQ7kNvwFgbQ3N&_nc_oc=AdqjI5TUHSSQWjJyFqA4go6O0WMpcrr-sTD3VMzcrkwEWUuWw3PHNIX3VZzU3HzWl3rwJGkWsyY3CZlEm7ZiOFds&_nc_zt=23&_nc_ht=scontent.ftlv20-2.fna&_nc_gid=xjD1wZgh5276QD6sg7inSA&_nc_ss=7b2a8&oh=00_Af4_0IXWiNiZjl2ti1EJ76HZ4SFifN8BIun7VdvT8FnxRg&oe=6A166445\"\r\n\t],\r\n      content: `● What does “Semitic” actually mean?\r\nSemitic ≠ ethnicity, Semitic ≠ race, Semitic ≠ one people.\r\n• Semitic is a linguistic and cultural category, not a biological one.\r\n• It refers to a family of languages that share a common linguistic ancestor (Proto-Semitic).\r\n * Examples of Semitic languages:\r\n• Akkadian\r\n• Canaanite languages (Phoenician, Hebrew)\r\n• Aramaic & Syriac\r\n• Arabic\r\n• South Semitic languages (Ethiopian languages, Old South Arabian)\r\n* Speaking a Semitic language does not mean you came from the same place or belong to the same population.\r\n● Where did Semitic languages come from?\r\n• The Proto-Semitic language likely developed somewhere in the Near East (Levant / northern Arabia / Mesopotamia region).\r\n• This is a linguistic hypothesis, not evidence of a mass human migration.\r\n• Languages can spread through:\r\n• trade\r\n• cultural dominance\r\n• administration\r\n• religion\r\n● Canaanites: who they actually were\r\n• Canaanites were indigenous Levantines.\r\n• They emerged in the Levant (Palestine, Lebanon, coastal Syria) during the Bronze Age.\r\n• They spoke Northwest Semitic languages.\r\n• Archaeology shows local continuity, not arrival from elsewhere.\r\n• Ancient DNA confirms genetic continuity between Canaanites and modern Levantine populations.\r\n* so in conclusion:\r\n• Canaanites are Semitic by language\r\n• Canaanites are not Arabs\r\n• Canaanites did not migrate from the Arabian Peninsula\r\n● Common ancestor ≠ same homeland\r\nYes, Semitic languages share a deep common ancestor.\r\nBut, that does not mean all Semitic speaking peoples came from Arabia.\r\nSame logic:\r\n• Latin ≠ Romans genetically everywhere\r\n● How this caught my attention\r\n I was helping students with a history question.\r\nThe question asked where Semitic people originally came from:\r\n The only options were\r\n1) the Arabian Peninsula\r\n2) Canaan.\r\nThe student had to choose one answer.\r\n•This is where the confusion starts.\r\nSemitic is a language category, not a people.\r\nCanaanites are an indigenous Levantine population. Mixing the two leads to a wrong conclusion.\r\n• Semitic languages may share a common ancestor. That does not mean all Semitic speaking peoples came from the same place.`\r\n    },\r\n\r\n\t{\r\n      title: \"\",\r\n      date: \"2025-11-02\",\r\n      photos: [\r\n\t  \"https://scontent.ftlv20-3.fna.fbcdn.net/v/t39.30808-6/573862177_1360274895890398_6122826191726855922_n.jpg?_nc_cat=103&ccb=1-7&_nc_sid=833d8c&_nc_ohc=qluY2umZMBAQ7kNvwEYVF3X&_nc_oc=AdqV0r-rOZWNu-52xF4OaoVGHpaBA1Yf1UayNePT-81HcbHdtYy53NpS1rPKyHcUWs6y59QA9dsQb8DlxTDgpxdq&_nc_zt=23&_nc_ht=scontent.ftlv20-3.fna&_nc_gid=LT871G1u7yF4e25zv1CyqA&_nc_ss=7b2a8&oh=00_Af4RDfEDI2FJsRGqAT14bWI-ou-TeK2TkVBKqAig-2AubA&oe=6A165E77\",\r\n\t  \"https://scontent.ftlv20-3.fna.fbcdn.net/v/t39.30808-6/574262290_1360274935890394_1385632938818856342_n.jpg?_nc_cat=105&ccb=1-7&_nc_sid=833d8c&_nc_ohc=WlWJ5oRakqAQ7kNvwGnkndm&_nc_oc=Ado3qfgSzXw4tWUGmfAVA1HoRBmzLe7GKotTJeTM7qNmUxNoT3nuGoZSwECBMEqlUMFghr7UE7W4tf6KEWOVdg-i&_nc_zt=23&_nc_ht=scontent.ftlv20-3.fna&_nc_gid=7Jhny69JbLF4Q0waN-OzNQ&_nc_ss=7b2a8&oh=00_Af7NrdAn3ZtgvDKHutUhWPJGYm9SmNslVTZXZVr6sCmqJA&oe=6A166D0E\"\r\n\t],\r\n      content: `● Your body is made of trillions of cells.\r\nEach one doing its job breathing, repairing, dividing without you telling it to.\r\nThey don’t know “you” exist, yet they make you.\r\n● Life began like that: simple organisms reacting to survival.\r\nNo identity. No purpose. No “self.”\r\nAs life evolved, it needed a control center to coordinate behavior.\r\nSo the brain formed its first layer \"the survival brain\".\r\nInstinct. Emotion. Territory. Fear. Desire.\r\n● Much later, the conscious mind appeared.\r\nNot to be deep or wise but to make better choices in complex environments.\r\n● So now we are two systems in one body:\r\n• The Subconscious: ancient, fast, emotional, animal.\r\n• The Conscious Mind: reflective, slow, strategic, aware.\r\n● the “self” we identify as is the tension point between them.\r\nThis is why humans contradict themselves.\r\nWe are biologically layered, not logically unified.\r\n● So Why Humans Don’t All Behave the Same?\r\nThe dominance between these two systems isn’t equal in everyone.\r\nIn some people, the conscious mind is stronger they can pause, observe themselves, question impulses, and act with intention.\r\nIn others, the subconscious is stronger\r\nthey react before thinking, driven by emotion, fear, jealousy, competition, and instinct.\r\nThey act first and explain later.\r\nThis has nothing to do with intelligence.\r\nIt’s about which system is driving the behavior.\r\nSome are humans managing the animal inside them.\r\nOthers are the animal wearing the costume of a human.\r\n● Universe 25: When Survival Ends, Instinct Breaks\r\nThere was an experiment where rats were given: food, shelter, safety, comfort... everything.\r\nTheir society still collapsed.\r\nBecause when survival has no purpose,\r\ninstinct turns inward.\r\n• Conflict appears from nothing\r\n• Identity dissolves\r\n• Roles break\r\n• Meaning disappears\r\n• Reproduction stops\r\nThe species collapses from comfort, not danger.\r\nHumans do the same.\r\nWhen life becomes easy, we manufacture new battles: drama, ego wars, emotional chaos, self destruction.\r\nNot because we want pain but because we need something to fight for to feel alive.\r\nWe are a species built for struggle.\r\nRemove the struggle, and we struggle with ourselves.\r\n● Not everyone evolves. Some just age.`\r\n    },\r\n\r\n\t{\r\n      title: \"\",\r\n      date: \"2025-09-26\",\r\n      photos: [\r\n\t  \"https://scontent.ftlv20-3.fna.fbcdn.net/v/t39.30808-6/555439611_1311099910807897_272959424517532980_n.jpg?_nc_cat=108&ccb=1-7&_nc_sid=833d8c&_nc_ohc=ZmdKjO_4HIQQ7kNvwGVNbez&_nc_oc=AdpeCjzdPvoasVxc6frBPEW8WB0S8s-IPx47ZyW_KKJ5q_wP8QVMCq3g6IXyINluA5yPD5GTZAF3EFMJgt_49BmO&_nc_zt=23&_nc_ht=scontent.ftlv20-3.fna&_nc_gid=9zPgAjBOZsEGkRM_nGC4mw&_nc_ss=7b2a8&oh=00_Af6q6BChAgXzN04ftPgwDqh48bh8lNb9-Cr_aclmkHBwqg&oe=6A167353\",\r\n\t  \"https://scontent.ftlv20-1.fna.fbcdn.net/v/t39.30808-6/555566637_1311099950807893_5170108580971065873_n.jpg?_nc_cat=106&ccb=1-7&_nc_sid=833d8c&_nc_ohc=ljGcgLHfAicQ7kNvwGmYI_4&_nc_oc=AdoJKBoljHMmNc-8O9B3TrXQkVw8-Hqp9KgJZ5PxSF947NPTeYWRlh3PFTX-8tDgXykYvglHdm-w4wXiyZQ5_UWX&_nc_zt=23&_nc_ht=scontent.ftlv20-1.fna&_nc_gid=y8Mzjmg_gaSBreBHygcyYQ&_nc_ss=7b2a8&oh=00_Af5PsWzabemYOVjGT4swsnx-vD74NRfKyS19Xw_mIZ3AxQ&oe=6A1655E7\",\r\n\t  \"https://scontent.ftlv20-2.fna.fbcdn.net/v/t39.30808-6/552939238_1311099987474556_7617868674152798965_n.jpg?_nc_cat=100&ccb=1-7&_nc_sid=833d8c&_nc_ohc=YgHCyXAOwvoQ7kNvwGN6hVB&_nc_oc=AdrCxZDcfFUpLAbzs-sSmtb6Cj5-QL2XMtotPIijbCWV-hDSBNaaY3uehcbcExwtfIA49M_0JHROycxWgzg-Jh9a&_nc_zt=23&_nc_ht=scontent.ftlv20-2.fna&_nc_gid=Gar8E7j8DbMUt2xdTBZfKw&_nc_ss=7b2a8&oh=00_Af7qThH9ltsnVvHFjp1A1iG8EAR11BeJBS6N61FkN5AWQA&oe=6A164494\",\r\n\t  \"https://scontent.ftlv20-1.fna.fbcdn.net/v/t39.30808-6/555529056_1311100020807886_6265004250844055942_n.jpg?_nc_cat=111&ccb=1-7&_nc_sid=833d8c&_nc_ohc=6Cuch4m15ygQ7kNvwGMsTGB&_nc_oc=AdpFt_lPuYmlnK5x3klVM_M5yx5j-lHxmjbvSYelCDCKEM2dtoyyDgBM3Cvp2sJ6808brWhsNh-qtZV6tvR-ya1R&_nc_zt=23&_nc_ht=scontent.ftlv20-1.fna&_nc_gid=b0FqnkvhbLC1BREHQmtjLQ&_nc_ss=7b2a8&oh=00_Af5uzhht9Agsf8U8DxgBOIr6K_osVmE8fZTElrEvTQ6BhA&oe=6A16435F\",\r\n\t  \"https://scontent.ftlv20-1.fna.fbcdn.net/v/t39.30808-6/554573407_1311100067474548_6831300859634660458_n.jpg?_nc_cat=107&ccb=1-7&_nc_sid=833d8c&_nc_ohc=hzh5Jo-qO3MQ7kNvwGDu-Ir&_nc_oc=AdrIIl12LrYDSZndjvPfDqotsbWyTEnmvTqsf7pBjNQ7Mx1BtnhWwjn9fKUqTMKNFW2nsQj-FvTM6ex12ycIumhp&_nc_zt=23&_nc_ht=scontent.ftlv20-1.fna&_nc_gid=t-IrNU8rVh-j2K3CsBYnIw&_nc_ss=7b2a8&oh=00_Af5nOEjwyA4UBN2HarGEuPUPnjv7zbESiAqzXvbGfrlSSQ&oe=6A166395\"\r\n\t],\r\n      content: `Fountain of Youth is it a myth or near future biology?\r\nFor centuries we’ve dreamed of “undoing” aging. Today, scientists chase it in two different ways, and both just got real data.\r\n1) Why aging is a problem:\r\nAs cells divide they accumulate DNA damage, telomeres shorten, mitochondria falter, and many cells enter senescence a “zombie” state that won’t divide or die but leaks inflammatory signals (SASP) that slowly wreck tissues and raise disease risk. Aging is basically the rising burden of these dysfunctional cells plus lost repair capacity.\r\n2) SRCs the “rebuild & rejuvenate” approach:\r\nChinese researchers engineered senescence-resistant mesenchymal progenitor cells (SRCs) (via longevity pathway tweaks, including FOXO3 activation). In aged macaques, 44 weeks (equivalent to humans in their 60s–70s)  of IV SRCs improved cognition, bone/vascular health, fertility markers, reduced fibrosis, and shifted gene expression in >50% of tissues toward a younger profile likely through exosomes that dampen inflammation, stabilize genomes, and boost mitochondrial function. No tumors were seen during the study window.\r\n3) FOXO4-DRI the “take out the trash” approach:\r\nIn senescent cells, FOXO4 binds p53 and prevents the death program which is the main reason why \"zombie\" cells exist. The peptide FOXO4-DRI disrupts this interaction so p53 can trigger apoptosis—selectively killing senescent (“zombie”) cells in animal models. Tissues then repopulate from healthy cells, improving function.\r\n4) How they differ its very simple:\r\n•FOXO4-DRI = senolytic: clears toxic old cells (garbage removal).\r\n•SRCs = pro-regenerative: add stress-resistant stem cells that secrete rejuvenating exosomes and help tissues recover (fresh supplies + better signals).\r\nTogether (in theory): first clear, then rebuild.\r\n5) “It worked in monkeys, so… humans?”\r\nMonkeys are close to us physiologically and genetically, so primate success is a stronger signal than mouse data. But dosing, durability, long-term safety (cancer/immune effects), manufacturing, and regulation remain open questions promising, not proven.\r\n6) Consequences to think about (medical + ethical):\r\n•Medical:\r\noff target effects, tumor risk, immune rejection, uneven organ responses, and unknown long-term outcomes.\r\n•Ethical & social:\r\nwho gets access, lifespan inequality, pension/health-system strain, effects on fertility and population.`\r\n    },\r\n\r\n\t{\r\n      title: \"\",\r\n      date: \"2025-6-27\",\r\n      photos: [\r\n        \"https://scontent.ftlv20-3.fna.fbcdn.net/v/t39.30808-6/514359071_1238185484766007_590265629250071977_n.jpg?_nc_cat=103&ccb=1-7&_nc_sid=833d8c&_nc_ohc=2f0F_ADEQ5UQ7kNvwEk70pf&_nc_oc=AdrK9ZrNOymjhcDVnd-SswqYUukfJOxvut90vzBqVzJhR8Dh1X0Mz4kOQO1H2VmmEvbA64A4IQ8xw5j6GeKX66Xz&_nc_zt=23&_nc_ht=scontent.ftlv20-3.fna&_nc_gid=pPSCYDL1CqbouCTSIA0qqQ&_nc_ss=7b2a8&oh=00_Af4tZTdYHDutx7PUrsLrPM7YJsidkGcblw6YTWYAfEWAtg&oe=6A164CD4\"\r\n      ],\r\n      content: `Ever catch yourself at 3 a.m. wondering why any of this matters? Same.\r\nI dove head-first into seven radically different philosophies, hoping one of them would hand me a map.\r\nInstead, they gave me mirrors.\r\nHere’s each mirror — and the thinker who polished it:\r\n----------------------------\r\n1. Nihilism – “Nothing has meaning. Life is a cosmic joke.”\r\n● Emil Cioran (Romanian philosopher of despair):\r\n> “It is not worth the bother of killing yourself, since you always kill yourself too late.”\r\nHe fully embraced absolute meaninglessness, bitterness, and cosmic indifference — and made poetry out of it.\r\nAlso: Leo Shestov, Jacques Rigaut, and many modern post-structuralists.\r\n◇ Nietzsche talked about nihilism but was not a supporter. He wanted to overcome it.\r\n2. Existentialism – “Life has no preset meaning. Create your own.”\r\n● Jean-Paul Sartre:\r\n> “Man is condemned to be free.”\r\n● Simone de Beauvoir:\r\n“Change your life today. Don’t gamble on the future, act now, without delay.”\r\n● Martin Heidegger:\r\n“Being-toward-death” — our mortality is what gives life urgency.\r\nExistentialists fully embraced freedom, choice, and personal responsibility in a meaningless world.\r\n3. Absurdism – “Life is meaningless, but we’re too human to accept that.”\r\n● Albert Camus (King of Absurdism):\r\n> “There is only one really serious philosophical question, and that is suicide.”\r\n“The struggle itself towards the heights is enough to fill a man’s heart.”\r\nHe believed in rebelling against the absurd, not giving in to despair.\r\n4. Determinism – “You’re not free. Everything is caused.”\r\n● Baruch Spinoza:\r\n> “In the mind there is no absolute or free will.”\r\n● Pierre-Simon Laplace (mathematician/philosopher):\r\n“If someone (a demon) knew all the variables in the universe, they could predict everything.”\r\nThey believed free will is an illusion — we are part of a vast, causal chain.\r\n5. Stoicism – “Control yourself, not the world.”\r\n● Epictetus:\r\n> “It’s not what happens to you, but how you react to it that matters.”\r\n● Marcus Aurelius:\r\n“You have power over your mind — not outside events.”\r\n● Seneca:\r\n“We suffer more in imagination than in reality.”\r\nTrue believers in mastering the self through reason, detachment, and acceptance of fate.\r\n6. Humanism – “Humans can be good and find purpose — no gods required.”\r\n● Bertrand Russell:\r\n> “I believe that when I die I shall rot, and nothing of my ego will survive... I do not fear death.”\r\nAlso: Carl Sagan, Richard Dawkins, and Erasmus.\r\nHumanists believe in reason, ethics, and humanity as enough to live a good life.\r\n7. Postmodernism – “There is no one truth. Everything’s a construct.”\r\n● Michel Foucault:\r\n> “Power is everywhere... because it comes from everywhere.”\r\n● Jacques Derrida:\r\n“There is nothing outside the text.”\r\n● Jean Baudrillard:\r\n“We live in a world more real than real: hyperreality.”\r\nThey believed that truth, identity, and reality itself are fragmented and shaped by culture and language.\r\n---------------------------\r\nAfter sitting with all these ideas, I realized I’m not just one thing.\r\nI carry the existential fire of Sartre — refusing to be defined by anyone but myself.\r\nI walk with Camus’ absurd defiance, laughing through the chaos even when it hurts.\r\nAnd I wear the stoic calm of Aurelius like armor — not because life is easy, but because I choose peace over panic.\r\nMaybe you’ll find yourself in one of them. Maybe in all. Or maybe in none.\r\nThe truth is — meaning isn’t waiting for you to find it.\r\nYou’re the one who has to build it.`\r\n    },\r\n\r\n\t{\r\n      title: \"\",\r\n      date: \"2025-06-13\",\r\n      photos: [\r\n        \"https://scontent.ftlv20-3.fna.fbcdn.net/v/t39.30808-6/506060243_1227263692524853_5722893377676047953_n.jpg?_nc_cat=109&ccb=1-7&_nc_sid=833d8c&_nc_ohc=1JWnkOmAyxcQ7kNvwHyrV8L&_nc_oc=AdoXM6lbEIwiiElNmemPdUGcgT0WNO6GZsE2uc_q73IUAj19qOJOD8oAF-nlsR_jYxDNPhMaVTHozbOtSERk7EE6&_nc_zt=23&_nc_ht=scontent.ftlv20-3.fna&_nc_gid=Iy0CSVoG3koOxEXavwY7Uw&_nc_ss=7b2a8&oh=00_Af7CEkWIqB7Vv92CK3R7iuFAsNZfWFSQ6ThB9JXR9YiPqA&oe=6A163EB1\"\r\n      ],\r\n      content: `The Ape Inside the Suit\r\nWe evolved brains that can split atoms, program AI, and map galaxies...\r\nBut one emotional trigger fear, rage, jealousy, tribal pride   and we drop the mask.\r\nWe’re not so different from animals,\r\nWe’re just well dressed primates pretending we’re in control.\r\n—\r\nTerritorial Instinct → “This is my land, my religion, my people. Get out.”\r\nWars begin with flags, not facts.\r\nTribalism & Groupthink → “You’re either with us, or against us.”\r\nWe choose belonging over truth. Echo chambers over understanding.\r\nAlpha Competition → “Respect me… or die.”\r\nWe still follow leaders who scream, not those who think. Politics becomes a jungle.\r\n—\r\nEvolution gave us the neocortex logic, language, reasoning.\r\nBut the limbic system: emotion, fear, desire.\r\nstill calls the shots when things get tense.\r\nWe’re not rational creatures.\r\nWe’re emotional animals with just enough intelligence to justify our instincts.\r\n—\r\nWe build rockets, then bomb each other.\r\nWe pray to gods, then kill in their name.\r\nWe cry for peace, then vote for war.\r\nWe’re just apes in suits.\r\nWith Wi-Fi. And nuclear weapons.\r\n—\r\nCivilization is a thin layer.\r\nInstinct is the default OS.\r\nAnd when it crashes, the beast takes over.`\r\n    },\r\n\r\n\t{\r\n      title: \"\",\r\n      date: \"2025-01-06\",\r\n      photos: [\r\n\t  \"https://scontent.ftlv20-3.fna.fbcdn.net/v/t39.30808-6/484932147_1160435939207629_6376349411549089143_n.jpg?_nc_cat=103&ccb=1-7&_nc_sid=833d8c&_nc_ohc=nWwf8k4worUQ7kNvwEfPpYU&_nc_oc=AdojIYQLihDCcR5KQWTsz2s-8GrKF2puqLm_SkCFqGi7_y-RvMw_kuH-IBEBfY8JR-3tlnqyoGGkelyBlSSfpqP7&_nc_zt=23&_nc_ht=scontent.ftlv20-3.fna&_nc_gid=eDqYaAmz5dd7pPcaraQFtQ&_nc_ss=7b2a8&oh=00_Af4N4Rpih-qoAvT35kbp-pzWsF2URD1NdQ_cmGqTN8YzoQ&oe=6A1649AF\",\r\n\t  \"https://scontent.ftlv20-1.fna.fbcdn.net/v/t39.30808-6/484831754_1160435935874296_8100494868123280237_n.jpg?_nc_cat=107&ccb=1-7&_nc_sid=833d8c&_nc_ohc=IO71rQoxrIYQ7kNvwF0cV_J&_nc_oc=AdrhVtWARMMBO9iANo6q3oAp6TrFIrk8P6ueSbydNlV9AhL08Jg_i8YD0bR8xC7qR9Hj_iPvDlvxoS8zTCiiQYcv&_nc_zt=23&_nc_ht=scontent.ftlv20-1.fna&_nc_gid=-Cawk7cbV4jSHgfRrEyi_Q&_nc_ss=7b2a8&oh=00_Af5pr-YFDsjoctT035Z7DhsRHUcrDRuA9otelravUpX2ZQ&oe=6A165137\",\r\n\t  \"https://scontent.ftlv20-1.fna.fbcdn.net/v/t39.30808-6/417835460_875072511077308_3051845585328789480_n.jpg?_nc_cat=107&ccb=1-7&_nc_sid=833d8c&_nc_ohc=xk7zfCvOZ-IQ7kNvwGxkPJ3&_nc_oc=AdqHo0ar3jf9RAkFzIJrmiykqCNDzO0cm537SkQua1GvvIElPC1X2AjMHKx612vI9vqPJoAgg0kjSqN_OsUByrTf&_nc_zt=23&_nc_ht=scontent.ftlv20-1.fna&_nc_gid=ixB60eLjHTvolE9Su_E0hA&_nc_ss=7b2a8&oh=00_Af4qySTUz9MkMBk2zlrKWnJXMfgcZXjlN6LO2LYuxcsgvg&oe=6A165669\",\r\n\t  \"https://scontent.ftlv20-3.fna.fbcdn.net/v/t39.30808-6/485180631_1160435962540960_114537380261445991_n.jpg?_nc_cat=109&ccb=1-7&_nc_sid=833d8c&_nc_ohc=m4W8ORo_l7EQ7kNvwGrQQnB&_nc_oc=AdqdgeS8AmmjO64_4FNZGbtww2JFJk2Kw3lOhHZZ_HdC4zoW22fEmVHke4D2QpAHurphR8Z7iNEyFMuoTVMKh4ao&_nc_zt=23&_nc_ht=scontent.ftlv20-3.fna&_nc_gid=m3FAvq4kmxF3jyDzExILxQ&_nc_ss=7b2a8&oh=00_Af5_QQFufntstrhhjnfgboDo5mI7rYChG_55V_4dj_hNpA&oe=6A164457\"\r\n\t],\r\n      content: `*Body dysmorphia? What's that?\r\nIt's a mental health condition where a person spends a lot of time worrying about flaws in their appearance, These flaws are often unnoticeable to others.\r\nYou can look good and get compliments and still think that they are just fawning,\r\nLot's of athletes actually suffer from body dysmorphia in fact distorted body image in the athletic population ranges from 12% to 57%.\r\n*What causes body dysmorphia?\r\nsocial media, peer influences, family influences basically the environment of constant improvement and competition against peers all can have an effect on how we view our bodies and how we treat our bodies.\r\n*The body positivity movement (the rise of morbidly obese people) \uD83C\uDF1A:\r\nAt first the body positivity movement started with good intentions, for a good cause, it was created to support people and encourage them to love themselves despite their imperfections, ( by imperfections mean things they were born with they can't control it like eczema for example)\r\nBut as always some idiots used it as an excuse for their bad health habits these idiots made the thing called \"fat acceptance\"\r\nThey started using the term body dysmorphia which is a serious mental health condition as an excuse for their obesity, morbidly obese people saying they were body dysmorphic and thought their body is not perfect but they got over it and accept themselves the way they are healthy and beautiful and forcing everyone to believe that forcing brands to hire morbidly obese models, anyone who refuses to believe their bullshit will be called \"Fat Phobic\", \"Fat Shaming\"\r\nthey ignore science they ignore reality even lot's of fat acceptance influencers themselves lost their lives because of their weight \"love yourself till you k*ill yourself\"\r\n*My struggle with body dysmorphia myself:\r\nI was underweight my whole teenage years and I always saw myself fat I need to lose more\r\nAt some point in my life when I was 20 years old I lost lot's of weight, I went from 48 to 40 kg in less than a month my bones were showing my mom and my best friend Alaa helped me through it I gained weight and became fit but still I wasn't pleased with how my body looks \"I need to lose belly fat\"\r\n\"I'm nothing like these influencers\" though I got lots of compliments I ignored them all and let my demons get to me.\r\nAfter years of struggling with my mental health I decided to work hard to stay healthy with the support of my family I accepted the fact that social media is fake, of course I still have these thoughts that I'm not perfect my demons never sleep but I know for a fact I'm healthy and that's all what matters.`\r\n    },\r\n\r\n\t{\r\n      title: \"\",\r\n      date: \"2022-10-06\",\r\n      photos: [\r\n\t  \"https://scontent.ftlv20-2.fna.fbcdn.net/v/t39.30808-6/477447759_1135307848387105_6728461240823175480_n.jpg?_nc_cat=100&ccb=1-7&_nc_sid=833d8c&_nc_ohc=vvs__WijGEoQ7kNvwGiB6Kl&_nc_oc=Ado85zzW4swvqzgKUhql9cfv_fKW_9nykk6MQR2wyYgPqQaOYxnmschmcHABDnLeLkcEMkCQncmGUTqxQe9PODdH&_nc_zt=23&_nc_ht=scontent.ftlv20-2.fna&_nc_gid=11QK47uiX-d973sa8GjcWg&_nc_ss=7b2a8&oh=00_Af6od_7bictTKMlPfvqiunk0-OKzMexcCGjkHx0BBmi-JQ&oe=6A165391\",\r\n\t  \"https://scontent.ftlv20-1.fna.fbcdn.net/v/t39.30808-6/310998672_593143322603563_5488777267503222186_n.jpg?_nc_cat=110&ccb=1-7&_nc_sid=833d8c&_nc_ohc=ADJcuzz1_EQQ7kNvwEnfbLV&_nc_oc=AdrZM_Rl-56jJbscEd6fdTY1r9io-IOM9CVWh6I49IICFF6ho9_RIH0LANkp_3xsrGSUmFujcqhp5PpjBPz_CxgK&_nc_zt=23&_nc_ht=scontent.ftlv20-1.fna&_nc_gid=akkUhYgw0O7HqhlcOplPzA&_nc_ss=7b2a8&oh=00_Af6FH0B50I0VD_RsSVPB4Ski5ShuJgSPg4ygtpFSkD9UXg&oe=6A166B45\",\r\n\t  \"https://scontent.ftlv20-2.fna.fbcdn.net/v/t39.30808-6/476876016_1135307851720438_4185637641188144431_n.jpg?_nc_cat=104&ccb=1-7&_nc_sid=833d8c&_nc_ohc=E7dN-58XAZ0Q7kNvwG-UgRv&_nc_oc=Adqw6hmGmb19U1-OeJS_k0ZxBtVTdE1hY0uf-7GssZfzoxNKvfhf3GB2JB9VppuAQ94eFcUIoPfRQSpbvfQCzFvv&_nc_zt=23&_nc_ht=scontent.ftlv20-2.fna&_nc_gid=NcIwsR8pJ4yny3MZvLY6Fw&_nc_ss=7b2a8&oh=00_Af78nXDDWpXcgdgCI7puU5udsW94enUq9CwVqi0r7Bk74g&oe=6A166C94\",\r\n\t  \"https://scontent.ftlv20-3.fna.fbcdn.net/v/t39.30808-6/477055718_1135308035053753_8017603341964063427_n.jpg?_nc_cat=109&ccb=1-7&_nc_sid=833d8c&_nc_ohc=xjRgQ0LrEYkQ7kNvwFZeovK&_nc_oc=AdqKqoyCdTbxaMOYAxD03tkOwoAUlZ5ArLcEaFvXNIQyx0WnGqEiidfCQFJtgZ7oAG0CpqWj4ONxXfrL7whiXhRc&_nc_zt=23&_nc_ht=scontent.ftlv20-3.fna&_nc_gid=rToAHFm-Eg18kg2g_--hUA&_nc_ss=7b2a8&oh=00_Af7LEieewVQ-6zSXdVld4imriw-IyivxBDIzS7aT5tNhCA&oe=6A1669FD\",\r\n\t  \"https://scontent.ftlv20-2.fna.fbcdn.net/v/t39.30808-6/310460957_593143415936887_1152173064666275057_n.jpg?_nc_cat=100&ccb=1-7&_nc_sid=833d8c&_nc_ohc=hN_TmUoB1ngQ7kNvwESrSCe&_nc_oc=AdrtF4vUME8MDYDJoZnqHgH46quk4EyhVfIVRo5wuQcxScCmzJjj6mUxq8mChoyA3F97i5AMCPGQhPoIYzPIh2o0&_nc_zt=23&_nc_ht=scontent.ftlv20-2.fna&_nc_gid=VTWHAHKmOoybCSIOirmNAA&_nc_ss=7b2a8&oh=00_Af5BxCoTHMSms88huJTEAyhhk2njLIztFz5C8yGY1QiAHg&oe=6A165DF1\"\r\n\t],\r\n      content: `الطفرات الجينية\r\n* شرح إضافي اسفل الصور*\r\nاي تغير فالقواعد النيتروجينية يسمى طفرة ممكن تصير بسبب:\r\n1) Insertion إضافة قواعد نيتروجينة\r\n2) Deletion  مسح قواعد نيتروجينة\r\n3) Duplicate نسخ قواعد نيتروجينية\r\n4) Inversion تبديل قواعد نيتروجينية\r\nونتيجة لهاي التغيرات بنتج عنا طفرات وفي انواع لهاي\r\nالطفرات:\r\n1) Silent-صامتة\r\n هي طفرات بتصير فالDNA ملهاش اي تأثير ملحوظ على الصفات الظاهرة للكائن الحي بتخربش الوظيفة او المعنى للمقطع.\r\n2) Nonsense اللامنطقية\r\nالطفرة غير المنطقية او طفرة التوقف هي تغيير في الDNA بتسسبب فإنهاء البروتين أو إنهاء ترجمته فوقت أبكر من ما هو متوقع بمعنى اخر بلغي وظيفة المقطع بعدش اله فايده ملهش معنى مثال على مرض نتيجة لهاي الطفرة هو التليف الكيسي.\r\n3) missense مغلوطة\r\nتغيير جيني بصير فيه استبدال مقطع اساسي واحد فبتغير الشفرة الوراثية بطريقة بتنتج حمض أميني بختلف عن الأحماض الأمينية يلي كان ينتجها قبل او بعطي ترجمة غير عن الترجمة الاصليه بمعنى اخر بغير وظيفة المقطع او البروتين عشان هيك بسموها مغلوطه بتعطينا ترجمة خاطئة من شو بدنا زي مثلًا مرض الانيميا المنجلية يلي بسبب طفرة بتغير شكل كريات الدم الحمراء بصيروا يشبهوا المنجل وهذا الاشي بمكنش هاي الخلايا من أداء وظيفتها بشكل سليم.`\r\n    },\r\n\r\n\t{\r\n      title: \"\",\r\n      date: \"2022-08-03\",\r\n      photos: [\r\n\t   \"https://scontent.ftlv20-2.fna.fbcdn.net/v/t39.30808-6/297392587_546928113891751_2131235391485916053_n.jpg?_nc_cat=100&ccb=1-7&_nc_sid=833d8c&_nc_ohc=NPa5tAsBmW4Q7kNvwHiIVuM&_nc_oc=AdolyDH0DKGgSKoBm9baaCVLpDi0UhMbKdL6hshh28ZKF1LUsQiqQC4ZWJj7TzmOYWrj9cErZlS-sQZcHWOIedTS&_nc_zt=23&_nc_ht=scontent.ftlv20-2.fna&_nc_gid=8djXysRKIWjvtt4mZr_G5Q&_nc_ss=7b2a8&oh=00_Af5QtWEIvfRVJmyK0WO1c0R4hdvjF133RkscYdfMVcWWgQ&oe=6A166C35\",\r\n\t\t\"https://cdn.jsdelivr.net/gh/bw3123/our-treasure@main/videos/breanS.mp4\",\r\n\t \"https://scontent.ftlv20-3.fna.fbcdn.net/v/t39.30808-6/477020919_1134612485123308_5530788743764183590_n.jpg?_nc_cat=105&ccb=1-7&_nc_sid=833d8c&_nc_ohc=Wwik8pRzer0Q7kNvwExUid-&_nc_oc=AdoPozJon51Sq5R1IJRUbviRqRlt0Ojxus1LLYL2aDPtjo4c0E06bFiQ3wKGu2DqGDtYDXnQTrnP1mRltfacGuha&_nc_zt=23&_nc_ht=scontent.ftlv20-3.fna&_nc_gid=AE3qqrhKMJ3Whp1Ur3G8tg&_nc_ss=7b2a8&oh=00_Af4b18SleR_D3Gxh6W9FdqfglN2P-hXO25hL0YoBu-yxyA&oe=6A167386\",\r\n\t  \"https://scontent.ftlv20-2.fna.fbcdn.net/v/t39.30808-6/297378563_546928207225075_4775513827203677201_n.jpg?_nc_cat=104&ccb=1-7&_nc_sid=833d8c&_nc_ohc=EXdFM_EKbLEQ7kNvwGfeTgY&_nc_oc=AdoTQf8WjL0BKlWb8UfNouhfc1oH7aFVPqpkiR3HRfAUhz6Rv5LVSld5vg7rrXtRObz18xEL8UCATYckdOZXg5Zx&_nc_zt=23&_nc_ht=scontent.ftlv20-2.fna&_nc_gid=S9uEZ7ypQcjFCtoxbFfyIQ&_nc_ss=7b2a8&oh=00_Af6_SErRYq-matNrYcgxWYuPDOZocjAbQJxexOc5VaIf9g&oe=6A1659DB\"\r\n\t],\r\n      content: `* كثير منسمع عن حركات ضد التطعيمات او بحكوا انه التطعيم هبل وفي ناس طعمت وانصابت بالمرض ونظريات مؤامره زي أنه التطعيم بغسل ادمغة الشباب وبحولهن لفاسقين او انه التطعيم بحتوي على شريحه للتحكم بالناس وسيطرة الماسونية على العالم او انه التطعيم بسبب التوحد او التطعيم بعمل سكتات قلبية.\r\n* بس لما نسال هاي الناس شو يعني تطعيم شو بكون جوابهن؟\r\nالله اعلم شو بحطوا فيه، مي وملح، فيروس ايدز، سم....الخ\r\n* هل بعرفوا شو عملت التطعيمات للبشرية؟\r\nاكيد لا، التطعيمات قضت على واحد من اكثر الامراض الفتاكه يلي قتل كثير ناس بالعالم يلي اليوم احنا منشوفه مرض تافه واللي هو الجدري (smallpox)،  قتل أكثر من 300 مليون شخص بس حملة التطعيم الضخمة وضعت حد للمرض فسنة 1977 وهيك هو بكون اول مرض تم القضاء عليه.\r\n* كيف اكتشفوا التطعيمات طيب؟\r\nفآخر القرن الثامن عشر، إدوارد جينر عمل دراسة على الآنسة ساره نيلمس يلي كانت تشتغل حلابة بقر بعد ما أُصيبت بالجدري(smallpox) ولاقوا انها كانت محصنه ضدّ الجدري (smallpox) لأنها انصابت بجدري البقر (cowpox) قبل ما تنصاب بالجدري (smallpox). فإستنتج جينر أنه أخذ مواد من جلد المصابة وحقنها بشخص آخر لإصابته بنفس المرض راح يعمل مناعة مستقبلية ضد مرض الجدري(smallpox) لأنه هذا المرض هو مشابه بس أقل خطورة.\r\n* كيف بشتغل التطعيم؟\r\nالتطعيمات بتحتوي على أجزاء ضعيفة أو مش فعالة من مسبب مرض معين ولما تفوت على الجسم بصير في استجابة مناعية.\r\nبتحتوي التطعيمات الأحدث على الشيفرة الوراثية تاعة مسبب المرض(DNA/RNA) بدل مسبب المرض نفسه.\r\nهاي التطعيمات اللي فيها نسخ ضعيفة من مسبب المرض مش راح تخلي الانسان يمرض بالمرض نفسه بس راح تحفز جهاز المناعه انه يشتغل ويكون خلايا ذاكرة عشان لما يدخل مسبب المرض الحقيقي يكون عنا رد مناعي جاهز للدفاع عن الجسم وبكنش تاثير مسبب المرض كبير عالجسم.\r\n*طبعًا الأجسام تختلف ونجاعة التطعيم بتختلف من شخص لآخر بس مبتضرش وبسببش التوحد ☻\uFE0F.`\r\n    },\r\n\r\n\t{\r\n      title: \"\",\r\n      date: \"2022-07-25\",\r\n      photos: [\r\n        \"https://scontent.ftlv20-3.fna.fbcdn.net/v/t39.30808-6/476642696_1134527321798491_8857115319852606430_n.jpg?_nc_cat=108&ccb=1-7&_nc_sid=833d8c&_nc_ohc=vcwa1Em8KH8Q7kNvwHKh34F&_nc_oc=AdqBxrwH_OWv9DzUIXrpDzz13PA8rbge82MvvVcp2lTrqrhVhfx408wtAq8UMaGruOw8AZJgOv_0c4-_IDXefdTJ&_nc_zt=23&_nc_ht=scontent.ftlv20-3.fna&_nc_gid=J-WyPgOtUbdk41TW59tY2A&_nc_ss=7b2a8&oh=00_Af6D4_E0_53Z5pVzyu5m8okcMd3rULF53W3qQdU0L3QjIw&oe=6A164EDF\"\r\n      ],\r\n      content: `كثير منسمع جملة تكنش كتلة هرمونات واستعمال هاي الجملة كإهانة خاصة للنساء، وكأنه الهرمونات مش اشي مهم او مفيد، مجرد مشاعر وبس.\r\nولكن الحقيقة غير هيك.......\r\nالهرمونات جزء مهم لاتمام عمليات الجسم هي بتنظم كثير اشيا بالجسم زي النمو، التكاثر، عمليات الأيض، نسبة السكر فالدم، الضغط والعطش....\r\nببساطة بخلوا الجسم يعرف شو لازم يعمل عشان يشتغل شغله بسلاسه ويحافظ على اتزانه.\r\n*شوية أمثلة:\r\n1) الدوبامين-Dopamine:\r\nهو هرمون وبشتغل كمان كناقل عصبي بتم انتاجه فدماغك، وهو يعتبر \"مركز المكافأة\" واله دور كبير بالعديد من الوظائف فالجسم زي:\r\nالحركة، الذاكرة، المكافأة والتحفيز، السلوك والإدراك، الانتباه، النوم واليقظة، المزاج، التعلم.\r\n2) السيروتونين-Serotonin:\r\nبلعب دور فتنظيم المزاج والسعادة والقلق.\r\nفي علاقة قوية بين المستويات المنخفضة من السيروتونين والإكتئاب، كل ما كان مستويات السيراتونين منخفضه بتزيد نسبة تعرض الشخص للإكتئاب.\r\n3) الجلوكاجون-Glucagon:\r\nهو هرمون بصنعه البنكرياس وهو بساعد فتنظيم مستويات الجلوكوز (السكر) في الدم.\r\nبزيد الجلوكاجون من مستوى السكر في الدم وبمنعه من الانخفاض لمستوى كبير عن طريق تحليل السكر المعقد جيلكوجين المُخزن بالجسم لجلوكوز.\r\n* التستوستيرون-Testosterone:\r\nاله كمان اسم هرمون الذكورة بس هو موجود عند كلا الجنسين بنسب مختلفه عند الذكور أعلى من الاناث لانه بنية الجسم والمتطلبات تختلف، لانه هرمون التستوستيرون بشتغل على تنظيم كتلة العظام ، توزيع الدهون بشكل معين ، كتلة العضلات وقوتها ، وإنتاج خلايا الدم الحمراء والحيوانات المنوية.\r\nبالاخر فش حاجه نزعل لما حدا يقلنا اننا كتلة هرمونات لانه هاي جزء لا يتجزأ من تكوين الإنسان  بدونهن فش عنده اتزان.`\r\n    },\r\n\r\n\t{\r\n      title: \"\",\r\n      date: \"2022-02-28\",\r\n      photos: [\r\n\t  \"https://scontent.ftlv20-1.fna.fbcdn.net/v/t39.30808-6/475272341_1122787296305827_4796165902145794240_n.jpg?_nc_cat=106&ccb=1-7&_nc_sid=833d8c&_nc_ohc=kdd3KWJGzB8Q7kNvwFGSl-T&_nc_oc=AdoXUUjIYxOBr-dfJCllVli5k7W4GhBXoZuudkaTcdCyE9z7o8nk2kA_M7lFDbn-vcn-UwbkvlLp51FXJkr8jJ2q&_nc_zt=23&_nc_ht=scontent.ftlv20-1.fna&_nc_gid=RTQP4XjsRPNj3W129muu5w&_nc_ss=7b2a8&oh=00_Af7DEf4Nk3eZ0hvG6l4JdNfVavTMPMo6XOBp10CTi0tOEw&oe=6A1663B8\",\r\n\t  \"https://cdn.jsdelivr.net/gh/bw3123/our-treasure@main/videos/dna.mp4\",\r\n\t  \"https://scontent.ftlv20-3.fna.fbcdn.net/v/t39.30808-6/474934039_1122787319639158_4089126138125822311_n.jpg?_nc_cat=108&ccb=1-7&_nc_sid=833d8c&_nc_ohc=AjbSrw2SJIkQ7kNvwGIKca4&_nc_oc=AdrCucdL3a8xVqsINK_hK9WHtq0exBUpsThNL_LBGs08E8AUrACAxYo4XPKIk_U-KGv-lttUAPQBbev8Qyf2WT_7&_nc_zt=23&_nc_ht=scontent.ftlv20-3.fna&_nc_gid=2znTPD38OgdeI-qXHWRxaQ&_nc_ss=7b2a8&oh=00_Af5f2AiwNk9ZGnBvsiyESdwsBcJwjbaBgUMPzZUlWAm1HQ&oe=6A166B14\"\r\n\t],\r\n      content: ` اذا حابين تشوفوا النتائج بشكل مفصل موجودات عالانستجرام عندي\r\nكان عندي فضول من زمان اعرف أصولي وكمان معلومات عني بالDNA خاصتي ولما سمعت انه 23ANDME بتقدر توفرلي هاي المعلومات بفحص لعاب صغير\r\nوصلتني ال KIT واستعملتها زي بالفيديو تحت وبعثتها للمختبر تبعهن\r\nبتاريخ 10/02 وصلتهن وبلشت مراحل الجد اللي هي:-\r\n● Step 1:\r\nThe Visual Exam -الاختبار البصري\r\nكل يوم بتوصل عينات لمختبر 23andme الموجود بأمريكا، بعد ما يفتحوا العلماء صناديق العينات بفحصوا العينة بصريًا (هل كمية اللعاب بتكفي؟ هل العينة ملوثة؟)\r\nبعدها بسخنوا العينات بداخل حاضن خاص لمدة ساعتين على درجة حرارة °50 عشان يوقفوا عمل اي انزيم موجود باللعاب يلي ممكن يحلل ال DNA ويفسد العينة.\r\n● Step 2:\r\nDNA Extraction-استخلاص DNA\r\nاستخراج ال DNA هو عملية هدفها تنقية وعزل الDNA الموجود فعينة اللعاب بتستغرق هاي الخطوة عادة من 7-14 يوم.\r\nبستخرجوا الDNA من خلايا الخد واللثة وخلايا الدم البيضاء يلي فعينة اللعاب، بعد ما تخلص هاي العملية بنسخوا عينة ال DNA ملايين المرات قبل ما يقطعوها لعدة قطع وينظفوها ويقيسوها.\r\n● Step 3:\r\nGenotyping - التنميط الجيني\r\nبتستغرق هاي لخطوة عادةً 3-10 أيام.\r\nبعد ما يتأكدوا العلماء انه عندهن كمية DNA كافية بستعملوا شريحة SNP مخصصة (أو microarray )  وهاي الشريحة بتمكن العلماء من انهن يقرأوا حوالي 600،000 حرف في عينة الDNA.\r\n○طيب ليش بس 600،000 حرف بس؟\r\nالجواب بسيط لأننا كلنا متماثلين بنسبة 99.9٪ بس مختلفين عن بعض ب 0.1٪ من الDNA\r\nوهاي ال0.1% هي يلي بتحدد صفاتك كشخص الشكلية ومنها بقدروا يتتبعوا الأصول العائلية\r\nكمان بقدروا يعرفوا شو الأمراض يلي ممكن تصيبك بالمستقبل (هل انت معرض للسكري لما تكبر او السمنه.....)\r\n● Step 4:\r\ntranslation- ترجمة\r\nبعد عملية التنميط الجيني بنتج عنا data عن الشخص بشكل الوان واحرف (A,T,C,G) او منقدر نقول كود او raw data يلي صعب الإنسان العادي يفهمها فبقوم قسم من المتخصصين بترجمة هاي ال raw data لكلمات وصفات بقدر يفهمها الإنسان العادي زي مثلا لون الشعر اسود او عندك اسلاف شرق اوسطيين`\r\n    },\r\n\r\n\t{\r\n      title: \"\",\r\n      date: \"2022-01-08\",\r\n      photos: [\r\n        \"https://scontent.ftlv20-3.fna.fbcdn.net/v/t39.30808-6/474624307_1121177256466831_8903086947270133423_n.jpg?_nc_cat=105&ccb=1-7&_nc_sid=833d8c&_nc_ohc=aT3Eu-xik0oQ7kNvwG4PLCM&_nc_oc=AdpTa9nYgFadGmNMAXxF2AHFRJwtaJ53rdZu94JKIOKF8u6dPGHa0ShfRQSf3aSIgn-yfz76YV_10BS_3vcH07e8&_nc_zt=23&_nc_ht=scontent.ftlv20-3.fna&_nc_gid=r3Xin8GoqK79LaW9eTMtvg&_nc_ss=7b2a8&oh=00_Af5zR7nSLGLabm3pcFfYK8QvhrBaPIYCTMzY41crWAMW_A&oe=6A165A6D\"\r\n      ],\r\n      content: `■ Mutations and the Immune system -  الطفرات وجهاز المناعة\r\n● Mutations definition- تعريف الطفرات:-\r\nA mutation is a change in a DNA sequence.\r\n الطفره هي اي تغير بصير في معادلة ال  DNA.\r\n○ What does the word DNA even mean?\r\n شو معنى كلمة DNA اصلا ?\r\nIn short DNA - Deoxyribonucleic acid is a molecule composed of two chains that coil around each other and carrying genetic instructions for the development, functioning, growth and reproduction of all known organisms and many viruses.\r\n* When it's a one chain the molecule then called RNA\r\nand some viruses contain RNA instead of DNA\r\nباختصار ال DNA- الحمض الريبي منقوص الاكسجين هو عباره عن سلسلتين ملفوفات حول بعض وبحملوا تعليمات جينية عشان التطور ،الوظائف الجسدية، النمو والتكاثر لكل الكائنات الحية المعروفه وفيروسات كثيره.\r\n* لما يكون المركب مكون من سلسلة وحده ساعتها بصير اسمه RNA بدل DNA وبعض الفيروسات بتحتوي على RNA بدل DNA\r\n● How mutations occur?\r\nكيف تحدث الطفرات؟\r\nMutations can result from DNA copying mistakes made during cell division, exposure to ionizing radiation, exposure to chemicals called mutagens, or infection by viruses.\r\nالطفرات ممكن تحدث بسبب خلل في عملية النسخ يلي بصير خلال عملية انقسام الخلايا، تعرض الجسم لأشعة مؤينه، تعرض الجسم لمواد كيميائية بسموها مطفره اي بتعمل طفرات والتعرض لفيروسات.\r\n●How mutations that occure in viruses can affect the immune system effectiveness?\r\nكيف الطفرات يلي بتصير بالفيروسات بتاثر على نجاعة جهاز المناعه؟\r\n As we said before the DNA carries the genetic instructions، it's like an ID card for organisms and viruses when a mutation happened it's like changing a number in the ID card the government or as we can call in this situation T cells (T immune memory cells) can't identify the virus to them it's a different organism or virus, as a result the whole process will start from zero.\r\nزي ما قلنا قبل ال DNA بيحمل التعليمات الجينية هو بمثل بطاقة هويه للكائنات الحية والفيروسات لما بتصير طفره بصير زي لما يتغير رقم بالهوية الحكومه او بهاي الحاله خلايا T (خلايا الذاكرة T لجهاز المناعة التخصصي ) بتقدرش تتعرف على الفيروس بالنسبه الهن هذا كائن حي او فيروس جديد، وكنتيجه لهيك عملية مكافحة الفيروس بترجع من الصفر .`\r\n    },\r\n\r\n\t{\r\n      title: \"\",\r\n      date: \"2021-11-09\",\r\n      photos: [\r\n        \"https://scontent.ftlv20-1.fna.fbcdn.net/v/t39.30808-6/470838424_1098771125374111_6137943284956419462_n.jpg?_nc_cat=107&ccb=1-7&_nc_sid=833d8c&_nc_ohc=b_zWiY0G3H0Q7kNvwElBeHT&_nc_oc=AdpwhbsFgfU9JetDIfOXg9abozkgsh_BG8coGzVMF6AI7KmgrWl6F7932WAUcrFyX1PD5S0FLUUebaQKeECXFmiE&_nc_zt=23&_nc_ht=scontent.ftlv20-1.fna&_nc_gid=zXDjnCgHiQj3T_EZ9QqE0g&_nc_ss=7b2a8&oh=00_Af6WIypEDms3yOsX7vYtflerrNSpE2prndc8BXVgL07vYg&oe=6A1668A8\"\r\n      ],\r\n      content: `\uD83E\uDD72`\r\n    },\r\n\r\n\t{\r\n      title: \"\",\r\n      date: \"2021-10-27\",\r\n      photos: [\r\n\t  \"https://scontent.ftlv20-3.fna.fbcdn.net/v/t39.30808-6/471193285_1098534095397814_7809563088115436758_n.jpg?_nc_cat=109&ccb=1-7&_nc_sid=833d8c&_nc_ohc=EseP1G4lCxMQ7kNvwF9INRq&_nc_oc=Ado0RMf8BQGGg9xKNB9DQrRl1l4J7GnHJl98Ut19pqtdFOPVlgzGLXhb2GJZQ3hW58m9WbG5xwpauDEWAL0eYz4l&_nc_zt=23&_nc_ht=scontent.ftlv20-3.fna&_nc_gid=2R4zBGv4roKk03uO5nED5w&_nc_ss=7b2a8&oh=00_Af4VcakJZOntRDUzcF0Kr6wE04yox7BD2L2vO99XBXiwbQ&oe=6A164B0A\",\r\n\t  \"https://cdn.jsdelivr.net/gh/bw3123/our-treasure@main/videos/dnav.mp4\"\r\n\t],\r\n      content: `*Junk DNA:-\r\nIn genetics, the term junk DNA refers to regions of DNA that are noncoding.\r\nDNA contains instructions (coding) that are used to create proteins in the cell. However, the amount of DNA contained inside each cell is vast and not all of the genetic sequences present within a DNA molecule actually code for a protein.\r\n*When we hear the term Junk we automatically think that it's useless but in the case of junk DNA the complete opposite, some examples:-\r\n1) Role in Evolution:-\r\nShared sequences of apparently non-functional DNA\r\nare a major line of evidence of common descent.\r\n2) Role in Forensic anthropology:-\r\nPolice sometimes gather DNA as evidence for purposes of forensic identification\r\nThe current standard for forensic DNA testing relies on an analysis of the chromosomes located within the nucleus of all human cells. 'The DNA material in chromosomes is composed of \"coding\" and \"non-coding\" regions. The coding regions are known as genes and contain the information necessary for a cell to make proteins. . . . Non-protein coding regions . . . are not related directly to making proteins,  have been referred to as \"junk\" DNA.' The adjective \"junk\" may mislead the lay person, for in fact this is the DNA region used with near certainty to identify a person. `\r\n    },\r\n\r\n\t{\r\n      title: \"\",\r\n      date: \"2021-09-12\",\r\n      photos: [\r\n        \"https://cdn.jsdelivr.net/gh/bw3123/our-treasure@main/videos/stupid.mp4\"\r\n      ],\r\n      content: `A wise man once said:\r\n\"Think of how stupid the average person is, and realize half of them are stupider than that.” George Carlin.\r\nA sentence that really means a lot if u think about it.`\r\n    },\r\n\r\n\t{\r\n      title: \"\",\r\n      date: \"2021-02-01\",\r\n      photos: [\r\n        \"https://scontent.ftlv20-1.fna.fbcdn.net/v/t1.6435-9/145744253_176460720938494_6051746198460893533_n.jpg?_nc_cat=106&ccb=1-7&_nc_sid=833d8c&_nc_ohc=hGDuPAYQs8gQ7kNvwFTjdwC&_nc_oc=Adqj9Zovz28L6Y-Q24i7J35fEC2yb7U2IJAiS6ODO8fJ9W_BhZ7PlEsR71Pc0kMB_ToFyIiTolztLdTa8IBS0Mak&_nc_zt=23&_nc_ht=scontent.ftlv20-1.fna&_nc_gid=og46KlkH_tmQzlyQAl1CiA&_nc_ss=7b2a8&oh=00_Af4qXl-IIC7uvZ72m33wt8h4TV0ZbtrQVsFbCcQkSPHsPQ&oe=6A37EE4E\"\r\n      ],\r\n      content: `* Ionic bond- الرابط الأيوني:-\r\n هو الرباط يلي بينشأ بين ذرتين بختلفوا فالقدرة على كسب أو فقد الإلكترونات.\r\nCovalent bond- الرابط الكوفلنتي:-\r\nبحدث نتيجة تشارك ذرتين على زوج من الالكترونات واله عدة أسماء زي تشاطري,تشاركي,تساهمي`\r\n    },\r\n\r\n\t{\r\n      title: \"\",\r\n      date: \"2021-01-26\",\r\n      photos: [\r\n        \"https://scontent.ftlv20-1.fna.fbcdn.net/v/t1.6435-9/142830433_171682904749609_1211633432766765074_n.jpg?_nc_cat=106&ccb=1-7&_nc_sid=833d8c&_nc_ohc=Tvq8mbJsKPQQ7kNvwHiuV1c&_nc_oc=AdpbpyryEMKd34JMaXN5EUZT3jvwXgMQq5evRzx3ZTfB7-SulloWaWRx0FzfVkMz7T2QW7TbyuJv20fPUfgCNNBr&_nc_zt=23&_nc_ht=scontent.ftlv20-1.fna&_nc_gid=sx16jXtT_UEEV3WfotOhgA&_nc_ss=7b2a8&oh=00_Af6G7MjGjLZkx9wrdg8W4xstGm8x4oV3p5cFaNxCdydTkw&oe=6A380BD4\"\r\n      ],\r\n      content: `Plants and animals use many different self defense strategies to protect themselves from certain predators`\r\n    },\r\n\r\n\t{\r\n      title: \"\",\r\n      date: \"2021-01-26\",\r\n      photos: [\r\n        \"https://scontent.ftlv20-2.fna.fbcdn.net/v/t1.6435-9/142238805_171256564792243_8489103883667837926_n.jpg?_nc_cat=102&ccb=1-7&_nc_sid=833d8c&_nc_ohc=ZCrmWUIolpAQ7kNvwH6Rmul&_nc_oc=AdoXkWaHjYEpXLFoaO2b5DodMoE9gCiH_R6auPhld8wKaBjm_Wv6C_7zxADcnuQ3E9ORbim6sXXXRhqgix78ubPb&_nc_zt=23&_nc_ht=scontent.ftlv20-2.fna&_nc_gid=Qs_mkNlOpa-4pBq9Yznw_w&_nc_ss=7b2a8&oh=00_Af7Wh3a3cQ0xnpcWWEHxzcfHHpQGE5xMXMGwCnbN4g7AXQ&oe=6A381D3D\"\r\n      ],\r\n      content: `Human centipede (Berni